% ==========================================================================
% informe.sty — Los documentos de «Prepara con Claude» (informes de cantes,
% dictámenes, escritos, cronogramas, fichas) con la misma plantilla que los
% temas del temario (oposicion/temario/latex/tcee.sty), en versión corta y
% autocontenida: cabecera y pie, apartados en banda, cajas, listas, tablas.
% Autor: Víctor Gutiérrez Marcos
%
% Se compila con XeLaTeX (fontspec): las fuentes OTF son las de assets/fuentes
% (TeX Gyre Pagella para TCEE, Latin Modern para DCE); la ruta la pone el
% script informe-pdf.py en \informefuentes antes de cargar el paquete.
% No depende de newpx, ulem, ccicons ni babel: si babel o polyglossia están
% (silabeo en español) se usan; si no, se definen a mano «Gráfico» y «Tabla».
%
% Uso (lo hace la plantilla informe.tex de pandoc):
%   \providecommand{\informefuentes}{fuentes/}
%   \usepackage[tcee]{informe}        % o [dce]
%   \renewcommand{\informefecha}{29 de octubre de 2026}
%   \begin{document}\informetitulo{Informe del cante · 3.A.8} … \end{document}
% Entornos: quote (pandoc, las citas «>») sale como caja con el fondo de la
% app; informeaviso es la caja pálida del aviso final.
% ==========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{informe}[2026/10/29 Documentos de Prepara con Claude]

% --- Oposición ------------------------------------------------------------
\newif\ifinforme@dce
\DeclareOption{tcee}{\informe@dcefalse}
\DeclareOption{dce}{\informe@dcetrue}
\DeclareOption*{\PackageWarning{informe}{Opción desconocida: \CurrentOption}}
\ExecuteOptions{tcee}
\ProcessOptions\relax

% --- Textos de cada oposición -----------------------------------------------
\ifinforme@dce
  \newcommand{\informe@oposicion}{Oposición a Diplomado Comercial del Estado}
  \newcommand{\informe@web}{manuelcabadogarcia.es}
  \newcommand{\informe@weburl}{https://manuelcabadogarcia.es/}
\else
  \newcommand{\informe@oposicion}{Oposición a Técnico Comercial y Economista del Estado}
  \newcommand{\informe@web}{victorgutierrezmarcos.es}
  \newcommand{\informe@weburl}{https://www.victorgutierrezmarcos.es/}
\fi
\newcommand{\informe@marca}{Prepara con Claude}
\newcommand{\informe@pieuso}{Uso personal del opositor \textperiodcentered\ Redactado por una IA: no sustituye a un preparador, lo complementa}

% --- Fecha (sin babel: los meses a mano) ---------------------------------------
\newcommand{\informehoy}{\number\day\ de \ifcase\month\or enero\or febrero\or marzo\or abril\or mayo\or junio\or julio\or agosto\or septiembre\or octubre\or noviembre\or diciembre\fi\ de \number\year}
\newcommand{\informefecha}{\informehoy}

% --- Fuentes (XeLaTeX + fontspec, OTF de assets/fuentes) -----------------------
\RequirePackage{amsmath}
\RequirePackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}
\providecommand{\informefuentes}{../fuentes/}
\ifinforme@dce
  \edef\informe@cargafuente{\noexpand\setmainfont{lmroman10}[Path=\informefuentes,Extension=.otf,
    UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]}
\else
  \edef\informe@cargafuente{\noexpand\setmainfont{texgyrepagella}[Path=\informefuentes,Extension=.otf,
    UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]}
\fi
\informe@cargafuente
% Código (`[04:00]`, ficheros): Latin Modern Mono si la distribución la tiene; si no, la de TeX
\IfFontExistsTF{lmmono10-regular.otf}{\setmonofont{lmmono10-regular.otf}[Scale=MatchLowercase]}{}
% Matemáticas: en TCEE, TeX Gyre Pagella Math si está (unicode-math); si no,
% o en DCE, las de Computer Modern (que son las de Latin Modern)
\newif\ifinforme@unicodemath
\ifinforme@dce\else
  \IfFileExists{unicode-math.sty}{\IfFontExistsTF{texgyrepagella-math.otf}{\informe@unicodemathtrue}{}}{}
\fi
\ifinforme@unicodemath
  \RequirePackage{unicode-math}
  \setmathfont{texgyrepagella-math.otf}
\else
  \RequirePackage{amssymb}
\fi
\IfFileExists{microtype.sty}{\RequirePackage{microtype}}{}

