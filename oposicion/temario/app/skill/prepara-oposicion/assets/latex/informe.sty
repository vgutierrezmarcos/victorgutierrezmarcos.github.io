  \renewcommand{\footrule}{{\color{informeprimario}\hrule height 0.6pt}}%
  \renewcommand{\footrulewidth}{0.6pt}%
}
\pagestyle{informe}

% --- Título del informe --------------------------------------------------------------
% Título en el color principal, filete debajo y una línea en versalitas con
% la marca, la oposición, la web y la fecha (la «cabecera» del DOCX).
\newcommand{\informetitulo}[1]{%
  {\raggedright\LARGE\bfseries\color{informeprimario}\hyphenpenalty=10000\exhyphenpenalty=10000 #1\par}%
  \nobreak\vspace{0.4em}\nobreak
  {\color{informefilete}\rule{\textwidth}{1pt}}\par\nobreak
  \vspace{0.35em}\nobreak
  {\footnotesize\scshape\color{informeprimario}\informe@marca\ \textperiodcentered\ \informe@oposicion\ \textperiodcentered\ \informe@web\ \textperiodcentered\ \informefecha\par}%
  \vspace{1.3em}}

% --- Apartados (como los temas) -------------------------------------------------------
% # (\section)         → banda en el color principal con texto blanco
% ## (\subsection)     → principal, negrita, con el filete debajo
% ### (\subsubsection) → secundario, negrita
% #### (\paragraph)    → secundario, cursiva
\setcounter{secnumdepth}{-2}
\newcommand{\informe@banda}[1]{%
  \colorbox{informeprimario}{\parbox{\dimexpr\textwidth-2\fboxsep}{%
    \large\bfseries\color{white}\raggedright\strut\MakeUppercase{#1}\strut}}}
\titleformat{\section}[block]{\normalfont}{}{0pt}{\informe@banda}
\titleformat{name=\section,numberless}[block]{\normalfont}{}{0pt}{\informe@banda}
\titlespacing*{\section}{0pt}{1.4em}{0.8em}
\titleformat{\subsection}{\normalfont\large\bfseries\color{informeprimario}\nobreak}{}{0pt}{}
  [\nobreak\vspace{-0.15em}{\color{informefilete}\nobreak\titlerule[0.6pt]}\nobreak]
\titlespacing*{\subsection}{0pt}{1.3em}{0.5em}
\titleformat{\subsubsection}{\normalfont\bfseries\color{informesecundario}\nobreak}{}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{1em}{0.3em}
\titleformat{\paragraph}{\normalfont\itshape\color{informesecundario}\nobreak}{}{0pt}{}
\titlespacing*{\paragraph}{0pt}{0.8em}{0.2em}
\titleformat{\subparagraph}{\normalfont\small\bfseries\color{informesecundario}\nobreak}{}{0pt}{}
\titlespacing*{\subparagraph}{0pt}{0.6em}{0.15em}
% Ningún título queda solo al pie de una página
\newcommand{\informe@sitio}[1]{\if@nobreak\else\Needspace{#1\baselineskip}\fi}
\preto\section{\informe@sitio{7}}
\preto\subsection{\informe@sitio{5}}
\preto\subsubsection{\informe@sitio{4}}
\preto\paragraph{\informe@sitio{3}}

% --- Listas (compactas, viñetas en el color principal) ---------------------------------
\setlist{itemsep=0.15em,topsep=0.3em,parsep=0.15em,beginpenalty=10000}
