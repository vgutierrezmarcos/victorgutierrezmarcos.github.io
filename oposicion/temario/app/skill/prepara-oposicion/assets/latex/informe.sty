% Imágenes: nunca más anchas que el texto (pandoc antiguo: \maxwidth; nuevo: \pandocbounded)
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>0.8\textheight 0.8\textheight\else\Gin@nat@height\fi}
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\newsavebox\informe@caja
\providecommand*\pandocbounded[1]{%
  \sbox\informe@caja{#1}%
  \Gscale@div\@tempa{0.8\textheight}{\dimexpr\ht\informe@caja+\dp\informe@caja\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\informe@caja}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\informe@caja}\else\usebox{\informe@caja}\fi}
