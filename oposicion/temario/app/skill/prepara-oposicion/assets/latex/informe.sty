  \informe@simbolo{"2714}{\ensuremath{\checkmark}}% ✔
  \informe@simbolo{"2713}{\ensuremath{\checkmark}}% ✓
  \informe@simbolo{"2705}{\ensuremath{\checkmark}}% ✅
