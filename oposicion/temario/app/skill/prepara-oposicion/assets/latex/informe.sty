\fancypagestyle{informe}{%
  \fancyhf{}%
  \fancyhead[L]{\footnotesize\bfseries\color{informeprimario}\informe@marca}%
  \fancyhead[C]{\footnotesize\itshape\color{informeprimario}\parbox[b]{0.56\textwidth}{\centering\informe@oposicion}}%
