\setlist[itemize,2]{label={\color{informeprimario}--},leftmargin=1.4em}
\setlist[itemize,3]{label={\color{informeprimario}\footnotesize$\circ$},leftmargin=1.4em}
\setlist[enumerate,1]{label={\color{informeprimario}\arabic*.},leftmargin=1.6em}
\setlist[enumerate,2]{label={\color{informeprimario}\alph*)},leftmargin=1.6em}
\setlist[enumerate,3]{label={\color{informeprimario}\roman*.},leftmargin=1.6em}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% --- Cajas ------------------------------------------------------------------------------
% Las citas «>» de pandoc (quote), con el bloque «Para la app»: fondo de la app
% (salvia o crema) y una raya del color del filete a la izquierda.
\tcolorboxenvironment{quote}{enhanced,breakable,
  colback=informefondo,colframe=informefilete,boxrule=0pt,leftrule=3pt,arc=1pt,
  fontupper=\small,colupper=informesecundario,left=8pt,right=8pt,top=5pt,bottom=5pt,
  before skip=0.6em,after skip=0.6em}
% Aviso final («Este informe lo ha redactado una IA…»): caja pálida en cursiva
\newtcolorbox{informeaviso}{enhanced,breakable,
  colback=informepalido,colframe=informepalido,boxrule=0pt,arc=2pt,
  fontupper=\footnotesize\itshape,colupper=informegris,left=8pt,right=8pt,top=5pt,bottom=5pt,
  before skip=1.6em,after skip=0.4em}

