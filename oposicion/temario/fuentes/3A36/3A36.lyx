\begin_layout Itemize

\emph on
Modelo
\emph default
: 
\begin_inset Formula $y_t=-b\,i_t+\varepsilon^{\mathrm{IS}}_t$
\end_inset

 y 
\begin_inset Formula $m_t=k\,y_t-h\,i_t+\varepsilon^{\mathrm{LM}}_t$
\end_inset

, con perturbaciones independientes; el banco central minimiza 
\begin_inset Formula $\mathbb{E}[y_t^2]$
\end_inset

 (
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:poole"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

). 
\end_layout

\begin_layout Itemize

\emph on
Tipo fijo
\emph default
 (
\begin_inset Formula $i_t=0$
\end_inset

): 
\begin_inset Formula $y_t=\varepsilon^{\mathrm{IS}}_t$
\end_inset

 y 
\begin_inset Formula $\mathbb{E}[y_t^2]_i=\sigma^2_{\mathrm{IS}}$
\end_inset

. 
\end_layout

\begin_layout Itemize

\emph on
Cantidad fija
\emph default
 (
\begin_inset Formula $m_t=0$
\end_inset

): de la LM, 
\begin_inset Formula $i_t=(k\,y_t+\varepsilon^{\mathrm{LM}}_t)/h$
\end_inset

. Sustituyendo en la IS, 
\begin_inset Formula $y_t\,(1+bk/h)=\varepsilon^{\mathrm{IS}}_t-(b/h)\,\varepsilon^{\mathrm{LM}}_t$
\end_inset

, es decir, 
\begin_inset Formula \[y_t=\frac{h\,\varepsilon^{\mathrm{IS}}_t-b\,\varepsilon^{\mathrm{LM}}_t}{h+b\,k},\qquad \mathbb{E}[y_t^2]_M=\frac{h^2\sigma^2_{\mathrm{IS}}+b^2\sigma^2_{\mathrm{LM}}}{(h+b\,k)^2},\]
\end_inset

porque las perturbaciones son independientes. 
\end_layout

\begin_layout Itemize

\emph on
ComparaciÃ³n
\emph default
: fijar el tipo es mejor si 
\begin_inset Formula $\mathbb{E}[y_t^2]_i<\mathbb{E}[y_t^2]_M$
\end_inset

, es decir, si 
\begin_inset Formula $(h+bk)^2\sigma^2_{\mathrm{IS}}<h^2\sigma^2_{\mathrm{IS}}+b^2\sigma^2_{\mathrm{LM}}$
\end_inset

. Desarrollando el cuadrado, 
\begin_inset Formula $(2hbk+b^2k^2)\,\sigma^2_{\mathrm{IS}}<b^2\sigma^2_{\mathrm{LM}}$
\end_inset

, y dividiendo por 
\begin_inset Formula $b^2\sigma^2_{\mathrm{IS}}$
\end_inset

, 
\begin_inset Formula \[\frac{\sigma^2_{\mathrm{LM}}}{\sigma^2_{\mathrm{IS}}}>k^2+\frac{2\,h\,k}{b} .\]
\end_inset

Si solo hay perturbaciones reales (
\begin_inset Formula $\sigma^2_{\mathrm{LM}}=0$
\end_inset

), conviene la cantidad; si solo hay monetarias (
\begin_inset Formula $\sigma^2_{\mathrm{IS}}=0$
\end_inset

), el tipo.
