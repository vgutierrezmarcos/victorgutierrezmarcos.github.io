\begin_layout Itemize

\emph on
Restricciones
\emph default
. Si la empresa eficiente elige 
\begin_inset Formula $(\overline{q},\overline{t})$
\end_inset

, obtiene 
\begin_inset Formula $\overline{t}-\underline{\beta}\,\overline{q}=\overline{U}+\Delta\beta\,\overline{q}$
\end_inset

: de ahÃ­ 
\begin_inset Formula $\mathrm{IC}_1$
\end_inset

. Si la ineficiente elige 
\begin_inset Formula $(\underline{q},\underline{t})$
\end_inset

, obtiene 
\begin_inset Formula $\underline{t}-\overline{\beta}\,\underline{q}=\underline{U}-\Delta\beta\,\underline{q}$
\end_inset

: de ahÃ­ 
\begin_inset Formula $\mathrm{IC}_2$
\end_inset

. Sumando las 2, 
\begin_inset Formula $\Delta\beta\,(\underline{q}-\overline{q})\geq 0$
\end_inset

: la eficiente produce al menos tanto como la ineficiente. 
\end_layout

\begin_layout Itemize

\emph on
Restricciones activas
\emph default
. Como cada euro de renta resta 
\begin_inset Formula $1-\alpha>0$
\end_inset

 de bienestar, el regulador deja la menor renta compatible: 
\begin_inset Formula $\overline{U}=0$
\end_inset

 (
\begin_inset Formula $\mathrm{PC}_2$
\end_inset

) y 
\begin_inset Formula $\underline{U}=\Delta\beta\,\overline{q}$
\end_inset

 (
\begin_inset Formula $\mathrm{IC}_1$
\end_inset

); 
\begin_inset Formula $\mathrm{PC}_1$
\end_inset

 se cumple sola. 
\end_layout

\begin_layout Itemize

\emph on
Problema reducido
\emph default
: 
\begin_inset Formula \[
  \max_{\underline{q},\overline{q}}\ \nu\big[S(\underline{q})-\underline{\beta}\,\underline{q}\big]+(1-\nu)\big[S(\overline{q})-\overline{\beta}\,\overline{q}\big]-\nu\,(1-\alpha)\,\Delta\beta\,\overline{q}.
  \]
\end_inset


\end_layout

\begin_layout Itemize

\emph on
Condiciones de primer orden
\emph default
: 
\begin_inset Formula $S'(\underline{q})=p(\underline{q})=\underline{\beta}$
\end_inset

, y 
\begin_inset Formula $(1-\nu)\big[p(\overline{q})-\overline{\beta}\big]=\nu\,(1-\alpha)\,\Delta\beta$
\end_inset

, que es 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:baron-myerson"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

. Subir la cantidad de la ineficiente aÃ±ade eficiencia cuando ese es el tipo (probabilidad 
\begin_inset Formula $1-\nu$
\end_inset

), pero encarece en 
\begin_inset Formula $\Delta\beta$
\end_inset

 por unidad la renta que se cede a la eficiente (probabilidad 
\begin_inset Formula $\nu$
\end_inset

). Las de segundo orden se cumplen porque 
\begin_inset Formula $S''=p'<0$
\end_inset

. 
\end_layout

\begin_layout Itemize

\emph on
ComprobaciÃ³n de 
\begin_inset Formula $\mathrm{IC}_2$
\end_inset


\emph default
: 
\begin_inset Formula $\overline{U}=0\geq\underline{U}-\Delta\beta\,\underline{q}=\Delta\beta\,(\overline{q}-\underline{q})$
\end_inset

, porque 
\begin_inset Formula $\underline{q}>\overline{q}$
