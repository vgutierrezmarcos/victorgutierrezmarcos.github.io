\begin_inset Formula \[
  \frac{\mathrm{PMg}_L}{\mathrm{PMg}_K}=\frac{I_L}{I_K}=\frac{w_L}{w_K-\frac{\mu}{1-\mu}(s-w_K)}>\frac{w_L}{w_K}.
