): 
\begin_inset Formula \begin{equation}\label{eq:binomial}
  c=\frac{\pi\,c_u+(1-\pi)\,c_d}{1+r},\qquad \pi=\frac{(1+r)-d}{u-d}.
  \end{equation}
\end_inset


\end_layout

\begin_layout Itemize

\emph on
Ejemplo
