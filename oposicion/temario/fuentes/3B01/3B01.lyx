name "anexo:gao"

\end_inset


\end_layout

\begin_layout Itemize
Con 
\begin_inset Formula $\mathrm{EBIT}=(p-c)\,q-\mathrm{CF}$
\end_inset

 y 
\begin_inset Formula $q^{\mathrm{PM}}=\mathrm{CF}/(p-c)$
\end_inset

, el EBIT es 
\begin_inset Formula $(p-c)\,(q-q^{\mathrm{PM}})$
\end_inset

, y 
\begin_inset Formula \[
  \mathrm{GAO}=\frac{(p-c)\,q}{(p-c)\,(q-q^{\mathrm{PM}})}=\frac{q}{q-q^{\mathrm{PM}}}=\frac{1}{\text{margen de seguridad}}.
  \]
\end_inset


\end_layout

\begin_layout Itemize
El GAO tiende a infinito cuando 
\begin_inset Formula $q\to q^{\mathrm{PM}}$
\end_inset

, es negativo si 
\begin_inset Formula $q<q^{\mathrm{PM}}$
\end_inset

 y tiende a 1 cuando 
\begin_inset Formula $q\to\infty$
\end_inset

. 
