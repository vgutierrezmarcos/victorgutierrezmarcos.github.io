\begin_inset Flex Concepto
status collapsed

\begin_layout Plain Layout
función de oferta
\end_layout

\end_inset

 
\begin_inset Formula $\phi(z;\pi)$
\end_inset

, lo mínimo que aceptaría por cada 
\begin_inset Formula $z$
\end_inset

 obteniendo un beneficio 
\begin_inset Formula $\pi$
\end_inset

. 
\end_layout

\begin_layout Itemize

\emph on
Equilibrio
\emph default
: la función hedónica 
\begin_inset Formula $p(z)$
\end_inset

