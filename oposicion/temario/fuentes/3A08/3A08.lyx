\begin_layout Paragraph
Elasticidad-precio cruzada: sustitutivos y complementarios brutos
\end_layout

\begin_layout Itemize
La 
\begin_inset Flex Concepto
status collapsed

\begin_layout Plain Layout
elasticidad-precio cruzada
\end_layout

\end_inset

 mide la variación porcentual de la cantidad demandada de un bien ante una variación porcentual del precio de otro: 
\begin_inset Formula \begin{equation}
  \varepsilon_{x_i,p_j}\equiv\frac{\partial x_i(p,\overline{W})}{\partial p_j}\cdot\frac{p_j}{x_i}. \label{eq:elasticidad-cruzada}
  \end{equation}
\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Si 
\begin_inset Formula $\varepsilon_{x_i,p_j}>0$
\end_inset

, el bien 
\begin_inset Formula $i$
\end_inset

 es 
\emph on
sustitutivo bruto
\emph default
 del 
\begin_inset Formula $j$
\end_inset

: si sube 
\begin_inset Formula $p_j$
\end_inset

, aumenta 
\begin_inset Formula $x_i$
\end_inset

. 
\end_layout

\begin_layout Itemize
Si 
\begin_inset Formula $\varepsilon_{x_i,p_j}=0$
\end_inset

, el bien 
\begin_inset Formula $i$
\end_inset

 es 
\emph on
independiente
\emph default
 del 
\begin_inset Formula $j$
\end_inset

. 
\end_layout

\begin_layout Itemize
Si 
\begin_inset Formula $\varepsilon_{x_i,p_j}<0$
\end_inset

, el bien 
\begin_inset Formula $i$
\end_inset

 es 
\emph on
complementario bruto
\emph default
 del 
\begin_inset Formula $j$
\end_inset

: si sube 
\begin_inset Formula $p_j$
\end_inset

, disminuye 
\begin_inset Formula $x_i$
\end_inset

. 
\end_layout

\end_deeper
\begin_layout Itemize
Estas relaciones 
\emph on
brutas
\emph default
 se basan en la demanda marshalliana, que incluye los efectos renta, y por eso 
\emph on
no son simétricas
\emph default
: el bien 
\begin_inset Formula $i$
\end_inset

 puede ser sustitutivo bruto del 
\begin_inset Formula $j$
\end_inset

 y, a la vez, el 
\begin_inset Formula $j$
\end_inset

 complementario bruto del 
\begin_inset Formula $i$
\end_inset

. 
\end_layout

\begin_layout Paragraph
Ecuación de Slutsky para el precio cruzado: sustitutivos y complementarios netos
\end_layout

\begin_layout Itemize
Ante variaciones del precio de otro bien, la ecuación de 
\begin_inset Flex Autor
status collapsed

\begin_layout Plain Layout
Slutsky
\end_layout

\end_inset

 también separa el efecto sustitución del efecto renta: 
\begin_inset Formula \begin{equation}
  \underbrace{\frac{\partial x_i(p,\overline{W})}{\partial p_j}}_{\text{efecto total cruzado}}=\underbrace{\frac{\partial h_i(p,\overline{U})}{\partial p_j}}_{\text{efecto sustitución cruzado}}\quad\underbrace{-\,x_j\,\frac{\partial x_i(p,\overline{W})}{\partial\overline{W}}}_{\text{efecto renta cruzado}}. \label{eq:slutsky-cruzada}
  \end{equation}
\end_inset


\end_layout

\begin_layout Itemize
Con el efecto sustitución cruzado se definen las relaciones 
\emph on
netas
\emph default
: los bienes son 
\begin_inset Flex Concepto
status collapsed

\begin_layout Plain Layout
sustitutivos netos
\end_layout

\end_inset

 si 
\begin_inset Formula $\partial h_i/\partial p_j>0$
\end_inset

 y 
\begin_inset Flex Concepto
status collapsed

\begin_layout Plain Layout
complementarios netos
\end_layout

\end_inset

 si 
\begin_inset Formula $\partial h_i/\partial p_j<0$
\end_inset

. 
\end_layout

\begin_deeper
\begin_layout Itemize
Los efectos sustitución cruzados son 
\emph on
simétricos
\emph default
 (
\begin_inset Formula $\partial h_i/\partial p_j=\partial h_j/\partial p_i$
\end_inset

), de modo que la sustituibilidad y la complementariedad netas son relaciones simétricas, a diferencia de las brutas. 
\end_layout

\begin_layout Itemize
Además, por la homogeneidad de grado cero de la demanda compensada en los precios, 
\begin_inset Formula $\sum_j p_j\,\partial h_i/\partial p_j=0$
\end_inset

; como el efecto sustitución propio es no positivo, 
\emph on
cada bien ha de tener al menos un sustitutivo neto
\emph default
