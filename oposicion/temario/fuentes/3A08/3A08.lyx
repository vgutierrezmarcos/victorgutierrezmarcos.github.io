 y no 
\begin_inset Formula $x^1\succcurlyeq x^0$
\end_inset

 (
\begin_inset Formula $x^0$
\end_inset

 es 
\emph on
mejor
\emph default
 que 
\begin_inset Formula $x^1$
\end_inset

); 
