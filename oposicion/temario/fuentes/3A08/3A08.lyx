\begin_inset Flex Autor
status collapsed

\begin_layout Plain Layout
Giffen
\end_layout

\end_inset


\emph default
: la demanda aumenta cuando sube el precio. 
\end_layout

\begin_layout Itemize
Entre los bienes ordinarios, la demanda es 
\emph on
elástica
\emph default
 si 
\begin_inset Formula $\varepsilon_{x_i,p_i}<-1$
\end_inset

