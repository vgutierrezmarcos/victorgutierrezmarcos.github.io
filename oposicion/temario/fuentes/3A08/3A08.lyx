\end_inset

 
\end_layout

\begin_deeper
\begin_layout Enumerate
es 
\emph on
no vacío
\emph default
, 
\begin_inset Formula $S\neq\varnothing$
\end_inset

: hay algo entre lo que elegir; 
\end_layout

\begin_layout Enumerate
es 
\emph on
cerrado
\emph default
: incluye su frontera, de modo que el límite de una sucesión de cestas factibles también es factible: si 
\begin_inset Formula $x^k\in S$
\end_inset

 y 
\begin_inset Formula $x^k\rightarrow x^0$
\end_inset

, entonces 
\begin_inset Formula $x^0\in S$
\end_inset

; 
\end_layout

\begin_layout Enumerate
está 
\emph on
acotado inferiormente
\emph default
: 
\begin_inset Formula $x\geq 0$
\end_inset

 para toda 
\begin_inset Formula $x\in S$
\end_inset

, porque las cantidades consumidas nunca son negativas; en el caso habitual contiene la cesta nula, 
\begin_inset Formula $0\in S$
\end_inset

. No está acotado superiormente: la escasez no la impone 
\begin_inset Formula $S$
\end_inset

, sino la restricción presupuestaria; 
\end_layout

\begin_layout Enumerate
es 
\emph on
convexo
\emph default
: dadas dos cestas factibles, cualquier combinación convexa de ellas también lo es, 
\begin_inset Formula $\lambda x'+(1-\lambda)x''\in S$
\end_inset

 para todo 
\begin_inset Formula $\lambda\in[0,1]$
\end_inset

. Implica la 
\emph on
perfecta divisibilidad
\emph default
 de los bienes. 
\end_layout

\end_deeper
