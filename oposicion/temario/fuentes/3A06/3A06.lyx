\begin_inset Formula $p_{i,t}=p_t+z_{i,t}$
\end_inset

 y quiere conocer 
\begin_inset Formula $z_{i,t}$
\end_inset

. Con 
\begin_inset Formula $p_t\sim N(p^e_t,\sigma^2_p)$
\end_inset

 y 
\begin_inset Formula $z_{i,t}\sim N(0,\sigma^2_z)$
\end_inset

 independientes, 
\begin_inset Formula $z_{i,t}$
\end_inset

 y 
\begin_inset Formula $p_{i,t}$
\end_inset

 son conjuntamente normales y la esperanza condicionada es lineal: 
\begin_inset Formula \begin{equation*}
  \mathbb{E}[z_{i,t}\mid p_{i,t}]=\frac{\mathrm{Cov}(z_{i,t},p_{i,t})}{\mathrm{Var}(p_{i,t})}\,\left(p_{i,t}-\mathbb{E}_{t-1}[p_{i,t}]\right)=\frac{\sigma^2_z}{\sigma^2_z+\sigma^2_p}\,\left(p_{i,t}-p^e_t\right)=\omega\,\left(p_{i,t}-p^e_t\right),
  \end{equation*}
\end_inset

porque 
\begin_inset Formula $\mathrm{Cov}(z_{i,t},p_t+z_{i,t})=\sigma^2_z$
\end_inset

, 
\begin_inset Formula $\mathrm{Var}(p_t+z_{i,t})=\sigma^2_p+\sigma^2_z$
\end_inset

 y 
\begin_inset Formula $\mathbb{E}_{t-1}[z_{i,t}]=0$
\end_inset

. 
\end_layout

