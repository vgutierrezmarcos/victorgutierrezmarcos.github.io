<?xml version="1.0" encoding="UTF-8"?><w:footnotes xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"><w:footnote w:type="continuationSeparator" w:id="0"><w:p><w:r><w:continuationSeparator /></w:r></w:p></w:footnote><w:footnote w:type="separator" w:id="-1"><w:p><w:r><w:separator /></w:r></w:p></w:footnote><w:footnote w:id="24"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">Robert</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:smallCaps /></w:rPr><w:t xml:space="preserve">Lucas</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">recibió el Premio Nobel de Economía en 1995 «por haber desarrollado y aplicado la hipótesis de las expectativas racionales, transformando así el análisis macroeconómico y profundizando en nuestra comprensión de la política económica»</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(</w:t></w:r><w:hyperlink w:anchor="ref_NobelPrize1995Lucas"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">Nobel Prize Outreach</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">, 1995</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">, traducción propia)</w:t></w:r><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p></w:footnote><w:footnote w:id="25"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">La cifra de la India de 2022 sale de una encuesta de gasto nueva, con otro cuestionario, y no es del todo comparable con las anteriores</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(</w:t></w:r><w:hyperlink w:anchor="ref_BM2026PIP"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">Banco Mundial</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">, 2026</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">)</w:t></w:r><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p></w:footnote><w:footnote w:id="28"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:smallCaps /></w:rPr><w:t xml:space="preserve">Smith</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(1776) vio en la</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:i /><w:iCs /></w:rPr><w:t xml:space="preserve">división del trabajo</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">la fuente de las ganancias de productividad;</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:smallCaps /></w:rPr><w:t xml:space="preserve">Ricardo</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(1817), en el</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:i /><w:iCs /></w:rPr><w:t xml:space="preserve">comercio internacional</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">la forma de escapar de los rendimientos decrecientes de la tierra, y</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:smallCaps /></w:rPr><w:t xml:space="preserve">Malthus</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(1798), en la presión de la población sobre los recursos el freno de la renta por habitante. Desde entonces, la renta por habitante de Estados Unidos y de Europa occidental se ha multiplicado por entre 12 y 23 en 2 siglos, y por entre 5 y 10 en el último</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(</w:t></w:r><w:hyperlink w:anchor="ref_BoltvanZanden2025"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">Bolt</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">y</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">van</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">Zanden</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">, 2025</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">)</w:t></w:r><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p></w:footnote><w:footnote w:id="29"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">Robert</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:smallCaps /></w:rPr><w:t xml:space="preserve">Solow</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">recibió el Premio Nobel de Economía en 1987 «por sus contribuciones a la teoría del crecimiento económico»</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(</w:t></w:r><w:hyperlink w:anchor="ref_NobelPrize1987Solow"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">Nobel Prize Outreach</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">, 1987</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">, traducción propia)</w:t></w:r><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p></w:footnote><w:footnote w:id="40"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">Con datos de 3 décadas,</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:smallCaps /></w:rPr><w:t xml:space="preserve">Panagariya</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(</w:t></w:r><w:hyperlink w:anchor="ref_Panagariya2004"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">2004</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">)</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">divide a los países en 3 grupos: los</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:i /><w:iCs /></w:rPr><w:t xml:space="preserve">milagros</w:t></w:r><w:r><w:t xml:space="preserve">, con un crecimiento medio por habitante de más del 3 % anual; los</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:i /><w:iCs /></w:rPr><w:t xml:space="preserve">desastres</w:t></w:r><w:r><w:t xml:space="preserve">, con un crecimiento nulo o negativo, y el resto. Los 2 extremos aparecen en todos los continentes.</w:t></w:r></w:p></w:footnote><w:footnote w:id="41"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">Las cifras de Nigeria dependen mucho de la fuente. Con el Maddison Project 2023, en 1960 Corea del Sur ya era algo más rica que Nigeria (1.548 frente a 1.307 dólares de 2011) y Nigeria creció un 2,2 % anual entre 1960 y 2022, no un 0,5 %; en 2022, la renta de Corea del Sur es 8 veces la de Nigeria</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(</w:t></w:r><w:hyperlink w:anchor="ref_BoltvanZanden2025"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">Bolt</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">y</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">van</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">Zanden</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">, 2025</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">)</w:t></w:r><w:r><w:t xml:space="preserve">. El patrón es el mismo: una se acercó a la frontera y la otra se quedó lejos.</w:t></w:r></w:p></w:footnote><w:footnote w:id="44"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">En el artículo de</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:smallCaps /></w:rPr><w:t xml:space="preserve">Kaldor</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(</w:t></w:r><w:hyperlink w:anchor="ref_Kaldor1961"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">1961</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">)</w:t></w:r><w:r><w:t xml:space="preserve">, el quinto hecho es, en rigor, una correlación alta entre la participación de los beneficios en la renta y la de la inversión en la producción, de modo que las participaciones son estables donde la inversión lo es. Es el hecho que más se discute hoy: la participación del trabajo ha caído en buena parte de las economías avanzadas desde los 80 (apartado </w:t></w:r><w:hyperlink w:anchor="sec_distribucion"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">I.3</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">), y también hay indicios de que la rentabilidad real del capital tiende a bajar hacia un cierto rango a medida que una economía se desarrolla.</w:t></w:r></w:p></w:footnote><w:footnote w:id="49"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">Es el mismo razonamiento que el de los hechos de</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:smallCaps /></w:rPr><w:t xml:space="preserve">Kaldor</w:t></w:r><w:r><w:t xml:space="preserve">: si el capital por trabajador aumenta sin que caiga su rendimiento, es porque el progreso técnico impide que caiga su producto marginal. Con el capital humano ocurre lo mismo: el aumento sostenido del trabajo cualificado frente al no cualificado no ha abaratado el primero, y una interpretación es que el progreso técnico</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:i /><w:iCs /></w:rPr><w:t xml:space="preserve">sesgado hacia la cualificación</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">ha aumentado su demanda relativa al mismo ritmo que su oferta.</w:t></w:r></w:p></w:footnote><w:footnote w:id="56"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">La función nació así. A principios del siglo XX, el economista Paul</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:smallCaps /></w:rPr><w:t xml:space="preserve">Douglas</w:t></w:r><w:r><w:t xml:space="preserve">, más tarde senador por Illinois, observó que el reparto de la renta de Estados Unidos entre trabajadores y capitalistas era casi constante, en torno al 70 y al 30 %, y preguntó a su colega matemático Charles</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:smallCaps /></w:rPr><w:t xml:space="preserve">Cobb</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">qué función de producción daría participaciones constantes si cada factor cobraba su producto marginal. La respuesta fue</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><m:oMath><m:r><m:t>Y</m:t></m:r><m:r><m:rPr><m:sty m:val="p" /></m:rPr><m:t>=</m:t></m:r><m:r><m:t>A</m:t></m:r><m:r><m:t> </m:t></m:r><m:sSup><m:e><m:r><m:t>K</m:t></m:r></m:e><m:sup><m:r><m:t>α</m:t></m:r></m:sup></m:sSup><m:sSup><m:e><m:r><m:t>L</m:t></m:r></m:e><m:sup><m:r><m:t>1</m:t></m:r><m:r><m:rPr><m:sty m:val="p" /></m:rPr><m:t>−</m:t></m:r><m:r><m:t>α</m:t></m:r></m:sup></m:sSup></m:oMath><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(</w:t></w:r><w:hyperlink w:anchor="ref_CobbDouglas1928"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">Cobb</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">y</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">Douglas</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">, 1928</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">;</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:hyperlink w:anchor="ref_Douglas1976"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /><w:smallCaps /></w:rPr><w:t xml:space="preserve">Douglas</w:t></w:r><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">, 1976</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">)</w:t></w:r><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p></w:footnote><w:footnote w:id="58"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">Aquí</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><m:oMath><m:r><m:t>σ</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">es la elasticidad de sustitución entre el capital y el trabajo; en el bloque </w:t></w:r><w:hyperlink w:anchor="sec_convergencia"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">III</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">,</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><m:oMath><m:sSub><m:e><m:r><m:t>σ</m:t></m:r></m:e><m:sub><m:r><m:t>t</m:t></m:r></m:sub></m:sSub></m:oMath><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">es la dispersión de las rentas entre países. No conviven en un mismo apartado.</w:t></w:r></w:p></w:footnote><w:footnote w:id="73"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
  </w:rPr>
  <w:footnoteRef />
</w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">La concentración puede deberse a las economías de escala y de red de la economía digital: solo las empresas más grandes pueden afrontar las grandes inversiones en datos, ordenadores y talento que exige competir.</w:t></w:r></w:p></w:footnote><w:footnote w:id="80"><w:p><w:pPr><w:pStyle w:val="FootnoteText" /></w:pPr><w:r>
  <w:rPr>
    <w:rStyle w:val="FootnoteReference" />
