\end_inset

 
\end_layout

\begin_layout Itemize

\emph on
La restricciÃ³n de incentivos
\emph default
. Con 
\begin_inset Formula $V_{\mathrm E}=V_{\mathrm S}$
\end_inset

, restando la segunda de la primera: 
\begin_inset Formula \[0=-\overline{e}-s\,\big(V_{\mathrm E}-V_{\mathrm U}\big)+(s+q)\,\big(V_{\mathrm E}-V_{\mathrm U}\big)\ \ \Longrightarrow\ \ V_{\mathrm E}-V_{\mathrm U}=\frac{\overline{e}}{q}\]
\end_inset


\end_layout

\begin_layout Itemize

\emph on
El salario
\emph default
. Restando la tercera de la primera, 
\begin_inset Formula $\rho\,\big(V_{\mathrm E}-V_{\mathrm U}\big)=(w-\overline{e})-(s+f)\,\big(V_{\mathrm E}-V_{\mathrm U}\big)$
\end_inset

, y con 
\begin_inset Formula $V_{\mathrm E}-V_{\mathrm U}=\overline{e}/q$
\end_inset

: 
\begin_inset Formula \[w=\overline{e}+\big(\rho+f+s\big)\,\frac{\overline{e}}{q}\]
\end_inset

El salario que evita el escaqueo sube con la tasa a la que los parados encuentran empleo: cuanto antes se vuelve a trabajar, menos castiga el despido. 
\end_layout

\begin_layout Itemize

\emph on
El estado estacionario
\emph default
. Las entradas en el paro, 
\begin_inset Formula $s\,J\,L$
\end_inset

, igualan a las salidas, 
\begin_inset Formula $f\,\big(\overline{L}-J\,L\big)$
\end_inset

: 
\begin_inset Formula \[f=\frac{s\,J\,L}{\overline{L}-J\,L},\qquad f+s=\frac{s\,\overline{L}}{\overline{L}-J\,L}=\frac{s}{U}\]
\end_inset

con 
\begin_inset Formula $U\equiv\big(\overline{L}-J\,L\big)/\overline{L}$
\end_inset

 la tasa de paro. Sustituyendo se obtiene la CNE 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:no-escaqueo"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

: 
\begin_inset Formula \[w=\overline{e}+\Big(\rho+\frac{s}{U}\Big)\frac{\overline{e}}{q}\]
\end_inset

Sin empleo (
\begin_inset Formula $J\,L=0$
\end_inset

, 
\begin_inset Formula $U=1$
\end_inset

) vale 
\begin_inset Formula $\overline{e}+(\rho+s)\,\overline{e}/q$
\end_inset

; crece con el empleo y tiende a infinito cuando 
\begin_inset Formula $J\,L\to\overline{L}$
\end_inset

