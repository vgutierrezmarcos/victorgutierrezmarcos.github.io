\begin_inset Formula \[r_A'(x)=-\frac{u'''u'-u''^2}{u'^2}=-\frac{u'''}{u'}+\left(\frac{u''}{u'}\right)^2=-P(x)\,r_A(x)+r_A(x)^2=r_A(x)\big[r_A(x)-P(x)\big],\]
\end_inset

