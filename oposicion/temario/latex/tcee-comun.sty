% --- Datos del tema ----------------------------------------------------------
\newcommand{\tcee@codigo}{}
\newcommand{\tcee@titulo}{}
\newcommand{\tcee@fecha}{\today}
\newcommand{\tcee@corto}{}
% \tcetema[título corto para la cabecera]{código}{título oficial}
\newcommand{\tcetema}[3][]{\renewcommand{\tcee@codigo}{#2}\renewcommand{\tcee@titulo}{#3}%
  \if\relax\detokenize{#1}\relax\renewcommand{\tcee@corto}{#3}\else\renewcommand{\tcee@corto}{#1}\fi}
\newcommand{\tcefecha}[1]{\renewcommand{\tcee@fecha}{#1}\tcee@sacaanno#1////\@nil}
\newcommand{\tceecodigo}{\tcee@codigo}
% Año de la licencia: el de \tcefecha{dd/mm/aaaa} (el año en curso si la fecha no es así)
\newcommand{\tcee@anno}{\the\year}
\newcommand{\tcee@mes}{\the\month}
\def\tcee@sacaanno#1/#2/#3/#4\@nil{\if\relax\detokenize{#3}\relax\else\edef\tcee@anno{\zap@space#3 \@empty}\edef\tcee@mes{\zap@space#2 \@empty}\fi\tcee@evaluaexclusivo}

% --- Exclusividad (materiales publicados o revisados desde el 1 de octubre de 2026) ---
% Se decide sola con la fecha de \tcefecha: desde el corte, el tema es «exclusivo»
% (aviso de uso personal en la portada, pie en todas las páginas y metadatos de
% derechos en vez de la licencia CC). \tceeexclusivofalse después de \tcefecha lo
% desactiva para un tema concreto. Los textos están también en
% scripts/temario/comun.py (web, Word, vídeo y manifiesto): cambiarlos a la vez.
\newif\iftceeexclusivo
\newcommand{\tcee@corteanno}{2026}
\newcommand{\tcee@cortemes}{10}
\newcommand{\tcee@evaluaexclusivo}{\tceeexclusivofalse
  \ifnum\tcee@anno>\tcee@corteanno\relax\tceeexclusivotrue\else
    \ifnum\tcee@anno=\tcee@corteanno\relax\ifnum\tcee@mes<\tcee@cortemes\relax\else\tceeexclusivotrue\fi\fi\fi}
