% --- Minutos del cante sin decimales ------------------------------------------------
% \tceemmss{2,5} → 2′30″; 26,5 → 26′30″; 1 → 1′. En el texto, \tiempo{2,5}
% (nunca «2,5 minutos»); tras el título de un apartado, \minutos{2,5} (tcee.sty)
% o \bloque[2,5] (ficha).
\ExplSyntaxOn
\tl_new:N \l__tcee_mmss_tl
\int_new:N \l__tcee_mmss_int
\cs_new_protected:Npn \tceemmss #1
  {
    \tl_set:Nx \l__tcee_mmss_tl { \tl_trim_spaces:n {#1} }
    \tl_replace_all:Nnn \l__tcee_mmss_tl { , } { . }
    \regex_match:nVTF { \A \d+ (\.\d+)? \Z } \l__tcee_mmss_tl
      {
        \int_set:Nn \l__tcee_mmss_int { \fp_eval:n { round ( ( \l__tcee_mmss_tl ) * 60 ) } }
        \int_eval:n { \int_div_truncate:nn { \l__tcee_mmss_int } { 60 } }
        \ensuremath { \sp { \prime } }
        \int_compare:nNnF { \int_mod:nn { \l__tcee_mmss_int } { 60 } } = { 0 }
          {
            \int_compare:nNnT { \int_mod:nn { \l__tcee_mmss_int } { 60 } } < { 10 } { 0 }
            \int_eval:n { \int_mod:nn { \l__tcee_mmss_int } { 60 } }
            \ensuremath { \sp { \prime\prime } }
          }
      }
      { #1 }
  }
\ExplSyntaxOff
\newcommand{\tiempo}[1]{\mbox{\tceemmss{#1}}}

% --- Énfasis propios ----------------------------------------------------------
% Personas: apellido en versalitas SIEMPRE que se nombra a alguien en el texto
% (\autor{Marshall}); el nombre de pila y el año van en redonda. Las citas
% (\textcite, \parencite) ya ponen el apellido en versalitas (tcee.sty).
\newcommand{\autor}[1]{\textsc{#1}}                        % \autor{Marshall} (1890)
% Vectores: flecha encima (\vect{x}, \vect{p}); los escalares sin flecha.
\providecommand{\vect}[1]{\vec{#1}}
\newcommand{\concepto}[1]{\textbf{#1}}                     % término clave

% --- Enlaces a otros temas -----------------------------------------------------------
% \vertema{3.A.12} es un enlace al tema citado: al PDF del tema en la web o, si
% aún no está disponible, a tema-no-disponible.html. Los destinos los escribe
% scripts/temario (comun.py, escribir_destinos_tex) en latex/tcee-destinos.tex a
% partir de temario.json: \tceedestino{3.A.12}{https://…/3A12.pdf}. Con un
% intervalo (\vertema{3.A.16-3.A.19}) enlaza al primer tema. Si el tema no está
% en la tabla, sale sin enlace (verificar-tema.py lo señala). El texto del enlace
% lo pone \tcee@textovertema: «[ver tema 3.A.12]» en el tema, «[3.A.12]» en la ficha.
\providecommand{\tceedestino}[2]{\expandafter\gdef\csname tcee@destino@#1\endcsname{#2}}
\InputIfFileExists{tcee-destinos.tex}{}{}
\def\tcee@primertema#1-#2\@nil{#1}
\newcommand{\tcee@enlacetema}[2]{% #1 código citado, #2 texto
  \begingroup\edef\tcee@vt{\tcee@primertema#1-\@nil}%
  \@ifundefined{tcee@destino@\tcee@vt}{#2}%
    {\href{\csname tcee@destino@\tcee@vt\endcsname}{#2}}%
  \endgroup}
\newcommand{\tcee@textovertema}[1]{[ver tema #1]}
% Gris y sin subrayar (hyperref usa colorlinks; el \color de dentro manda)
\newcommand{\vertema}[1]{\tcee@enlacetema{#1}{{\color{tceegris}\tcee@textovertema{#1}}}}
% \vertemacorto{3.A.12}: el mismo enlace que \vertema, pero el texto es solo el
% código, en gris (para tablas con muchos temas; Víctor, 24/10/2026, D-13 de 1D01)
\newcommand{\vertemacorto}[1]{\tcee@enlacetema{#1}{{\color{tceegris}#1}}}

% --- Fórmulas: funciones clave y problemas de optimización ------------------------
% Estilo de las funciones clave (morada, recuadrada, fondo morado pálido); el
% tema y la ficha definen \funcionclave sobre él (en display con número
% opcional en el tema; centrada y compacta en la ficha).
\tcbset{tcee funcion clave/.style={enhanced,nobeforeafter,colback=tceemoradopalido!70!white,
  colframe=tceemorado,colupper=tceemorado,boxrule=0.8pt,arc=2pt,left=8pt,right=8pt,top=4pt,bottom=4pt}}
% \optim{\max}{\vect{z}}{p\,F(\vect{z})-\vect{w}\cdot\vect{z}}{F(\vect{z})\geq q\\ \vect{z}\geq\vect{0}}
% → problema de optimización: «max» con la variable debajo y la función
% objetivo en la primera línea; debajo, «s.a.» y cada restricción en su línea
% (separadas por \\), alineadas. Va dentro de $$…$$, \[…\], equation o
% \funcionclave. Sin restricciones: {} en el cuarto argumento. Para la web y
% Word, construir-tema.py lo expande a un array antes de pandoc.
\ExplSyntaxOn
\seq_new:N \l__tcee_restr_seq
\NewDocumentCommand{\optim}{mmmm}
  {
    \seq_set_split:Nnn \l__tcee_restr_seq { \\ } {#4}
    \seq_remove_all:Nn \l__tcee_restr_seq { }
    \begin{array}{@{}r@{\quad}l@{}}
      \displaystyle #1 \sb { #2 } & \displaystyle #3
      \seq_if_empty:NF \l__tcee_restr_seq
        { \\ [2pt] \text{s.a.} & \seq_use:Nn \l__tcee_restr_seq { \\ [2pt] & } }
    \end{array}
  }
\ExplSyntaxOff
% \findemo → ∎ al final de una demostración, alineado a la derecha (Víctor,
% 17/10/2026). En una fórmula en display va tras un \quad.
\newcommand{\findemo}{\ifmmode\quad\blacksquare\else\unskip\nobreak\hfill\penalty50\hskip1em\null\nobreak\hfill$\blacksquare$\fi}

\endinput
