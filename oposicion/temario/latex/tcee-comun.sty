% ==========================================================================
% tcee-comun.sty — Lo que comparten el tema (tcee.sty) y la ficha de repaso
% (tcee-repaso.sty): idioma, Palatino, colores, datos del tema, minutos sin
% decimales, énfasis (\autor, \concepto, \vect), enlaces a otros temas
% (\vertema), problemas de optimización (\optim), estilo de las funciones
% clave, ∎ de fin de demostración y la licencia.
% Oposición a Técnico Comercial y Economista del Estado
% Autor: Víctor Gutiérrez Marcos
%
% No se usa directamente: lo cargan tcee.sty y tcee-repaso.sty. Si se añade
% una orden aquí, hay que añadir su equivalente en pandoc-macros.tex, tcee.lua
% o construir-tema.py (web y Word) y, si LyX debe entenderla, en tcee.module.
% ==========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tcee-comun}[2026/10/19 Base común de los temas y fichas TCEE]

% --- Idioma y codificación ------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[spanish,es-noshorthands,es-tabla,es-nodecimaldot]{babel}
% \min, \max, \lim… sin tilde: con newpxmath, la tilde de babel deja «mın» sin
% punto en la i (y el castellano técnico no la usa en los operadores)
\unaccentedoperators
\RequirePackage{csquotes}

% --- Tipografía: Palatino (texto y matemáticas) ----------------------------
