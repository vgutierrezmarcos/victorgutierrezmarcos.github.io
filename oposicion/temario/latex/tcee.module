#\DeclareLyXModule{Temario TCEE (tcee.sty)}
#\DeclareCategory{Temario TCEE}
#DescriptionBegin
#Órdenes y cajas de tcee.sty para editar en LyX los temas del 3.er y 4.º
#ejercicio de la oposición TCEE: autor, concepto, referencia a otro tema,
#fuente, minutos del cante (\minutos y \tiempo), gráfico en una nota al
#pie (\graficonota) y cajas (nota al opositor, anotaciones, idea clave,
#esquema; gráfico, figura, imagen y tabla dentro de una caja) y los flotantes
#«Figura» (esquemas e infografías propias) e «Imagen» (jpg/png pegados tal
#cual), cada uno con su numeración, aparte de los gráficos. \funcionclave y \optim llevan fórmulas como argumento: en LyX
#van en código TeX (ERT), como las deja tex2lyx. El documento carga tcee.sty en el preámbulo.
#DescriptionEnd
# Autor: Víctor Gutiérrez Marcos
#
# Instalación: copiar a %APPDATA%\LyX2.4\layouts\ y Herramientas >
# Reconfigurar (scripts/temario/construir-tema.py lo copia solo).

Format 104

InsetLayout Flex:Autor
	LyxType               charstyle
	LabelString           autor
	LatexType             command
	LatexName             autor
	Font
	  Shape               Smallcaps
	EndFont
	ResetsFont            true
End

InsetLayout Flex:Concepto
	LyxType               charstyle
	LabelString           concepto
	LatexType             command
	LatexName             concepto
	Font
	  Series              Bold
	EndFont
	ResetsFont            true
End

InsetLayout Flex:Ver_tema_corto
	LyxType               charstyle
	LabelString           "tema"
	LatexType             command
	LatexName             vertemacorto
	Font
	  Color               gray
	EndFont
	ResetsFont            true
End

InsetLayout Flex:Ver_tema
	LyxType               charstyle
	LabelString           "ver tema"
	LatexType             command
	LatexName             vertema
	Font
	  Color               gray
	EndFont
	ResetsFont            true
End

InsetLayout Flex:Fuente
	LyxType               custom
	LabelString           Fuente
	LatexType             command
	LatexName             fuente
	Decoration            classic
	Font
	  Shape               Italic
	  Size                Small
	EndFont
	MultiPar              false
End

InsetLayout Flex:Minutos
	LyxType               custom
	LabelString           min
	LatexType             command
	LatexName             minutos
	Decoration            conglomerate
	Font
	  Color               gray
	  Size                Small
	EndFont
	MultiPar              false
End

InsetLayout Flex:Tiempo
	LyxType               custom
	LabelString           "min (texto)"
	LatexType             command
	LatexName             tiempo
	Decoration            conglomerate
	Font
	  Color               gray
	EndFont
	MultiPar              false
End

InsetLayout Flex:Grafico_nota
	LyxType               custom
	LabelString           "gráfico en nota"
	LatexType             command
	LatexName             graficonota
	Decoration            classic
	PassThru              true
	MultiPar              false
	Font
	  Family              Typewriter
	EndFont
End

InsetLayout Flex:Nota_al_opositor
	LyxType               custom
	LabelString           "Nota al opositor"
	LatexType             environment
	LatexName             notaopositor
	Decoration            classic
	MultiPar              true
	BgColor               lightgray
End

InsetLayout Flex:Anotaciones
	LyxType               custom
	LabelString           Anotaciones
	LatexType             environment
	LatexName             anotaciones
	Decoration            classic
	MultiPar              true
End

InsetLayout Flex:Idea_clave
	LyxType               custom
	LabelString           "Idea clave"
	LatexType             environment
	LatexName             ideaclave
	Decoration            classic
	MultiPar              true
	Font
	  Shape               Italic
	EndFont
End

InsetLayout Flex:Grafico_en_caja
	LyxType               custom
	LabelString           "Gráfico en caja"
	LatexType             environment
	LatexName             figuracaja
	Decoration            classic
	MultiPar              true
End

InsetLayout Flex:Imagen_en_caja
	LyxType               custom
	LabelString           "Imagen en caja"
	LatexType             environment
	LatexName             imagencaja
	Decoration            classic
	MultiPar              true
End

InsetLayout Flex:Figura_en_caja
	LyxType               custom
	LabelString           "Figura en caja"
	LatexType             environment
	LatexName             infografiacaja
	Decoration            classic
	MultiPar              true
End

InsetLayout Flex:Tabla_en_caja
	LyxType               custom
	LabelString           "Tabla en caja"
	LatexType             environment
	LatexName             tablacaja
	Decoration            classic
	MultiPar              true
End

InsetLayout Flex:Esquema
	LyxType               custom
	LabelString           "Esquema del tema"
	LatexType             environment
	LatexName             esquema
	Decoration            classic
	MultiPar              true
End

# Imagen (tcee.sty, \DeclareCaptionType{imagen}): solo archivos pegados tal cual
# (jpg, png o pdf sin .tex fuente); lo dibujado va en figure («Gráfico n»)
Float
	Type                  imagen
	GuiName               Imagen
	Placement             H
	Extension             loi
	NumberWithin          none
	Style                 plain
	ListName              "Lista de imágenes"
	IsPredefined          true
	UsesFloatPkg          false
	RefPrefix             img
End

# Figura (tcee.sty, \DeclareCaptionType{infografia}): esquemas, mapas
# conceptuales, cajas y flechas, cascadas de cuentas, líneas de tiempo e
# infografías propias dibujadas en graficos/x.tex que no son un gráfico
# (sin ejes ni datos); los gráficos analíticos y de datos van en figure
Float
	Type                  infografia
	GuiName               Figura
	Placement             H
	Extension             lfg
	NumberWithin          none
	Style                 plain
	ListName              "Lista de figuras"
	IsPredefined          true
	UsesFloatPkg          false
	RefPrefix             figu
End
