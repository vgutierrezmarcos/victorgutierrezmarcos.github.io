% ==========================================================================
% tcee-repaso.sty — Ficha de repaso de un tema en exactamente cuatro páginas
% Oposición a Técnico Comercial y Economista del Estado
% Autor: Víctor Gutiérrez Marcos
%
% Lo que comparte con el tema (idioma, Palatino, colores, \tcetema, \tiempo,
% \autor, \concepto, \vect, \vertema, \optim, \findemo, licencia) está en tcee-comun.sty.
% Misma estética que los temas (tcee.sty): Palatino, morado #5F2987 y
% salvia #E2EFD9, pero en A4 a dos columnas (Víctor, 14/10/2026; antes, dos páginas a tres). El tamaño lo
% elige scripts/temario/construir-repaso.py (\tceetam) para que la ficha
% ocupe exactamente cuatro páginas.
%
% Uso (fuentes/<tema>/repaso/<tema>-repaso.tex):
%   \documentclass{article}
%   \usepackage{tcee-repaso}
%   \tcetema[Teoría de la demanda del consumidor (I)]{3.A.8}{<título oficial>}
%   \tcefecha{11/10/2026}
%   \begin{document}
%   \cabecerarepaso
%   \begin{columnas}
%   \bloque{Esquema del cante}  ... \esquemacante{...}
%   \bloque{I. La función de demanda} ...
%   \end{columnas}
%   \end{document}
% ==========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tcee-repaso}[2026/10/11 Fichas de repaso TCEE]

\RequirePackage{tcee-comun}
\RequirePackage[a4paper,top=1.1cm,bottom=1.2cm,left=1.2cm,right=1.2cm,
  headheight=0pt,headsep=0pt,footskip=0.45cm]{geometry}
\RequirePackage{multicol}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage[hidelinks,unicode]{hyperref}
\pdfstringdefDisableCommands{\def\newline{ }}

% --- Tamaño de letra (lo fija construir-repaso.py) ----------------------------
\providecommand{\tceetam}{8}
\newcommand{\tcee@tamano}{\fontsize{\tceetam}{\dimexpr\tceetam pt*115/100\relax}\selectfont}
\AtBeginDocument{\tcee@tamano}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.15em}
\setlength{\columnsep}{0.6cm}
\setlength{\columnseprule}{0.3pt}
\renewcommand{\columnseprulecolor}{\color{tceesalviaoscuro}}
\setlength{\abovedisplayskip}{2pt}\setlength{\belowdisplayskip}{2pt}
\setlength{\abovedisplayshortskip}{1pt}\setlength{\belowdisplayshortskip}{1pt}
\graphicspath{{../graficos/}{graficos/}}

% --- Licencia en los metadatos (CC BY-NC-ND 4.0, como en tcee.sty) ----------------
\tcee@licenciaxmp

% --- Pie --------------------------------------------------------------------------
\fancypagestyle{repaso}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[L]{\scriptsize\itshape\color{tceemorado}\tcee@codigo\ · Ficha de repaso · \tcee@corto}%
  \fancyfoot[R]{\scriptsize\itshape\color{tceemorado}\textcopyright\,\tcee@anno\ Víctor Gutiérrez Marcos ·
    \href{\tcee@licenciaurl}{CC BY-NC-ND 4.0} · victorgutierrezmarcos.es · \thepage/\pageref*{LastPage}}}
\pagestyle{repaso}

% --- Cabecera (banda morada) -----------------------------------------------------------
\newcommand{\cabecerarepaso}{%
  \noindent\colorbox{tceemorado}{\parbox{\dimexpr\textwidth-2\fboxsep}{%
    \vspace{2pt}{\color{white}\small\bfseries\tcee@codigo\hfill
    {\mdseries\itshape Ficha de repaso · actualizada el \tcee@fecha}}\\[1pt]
    {\color{white}\bfseries\normalsize\tcee@titulo}\vspace{2pt}}}\par\vspace{3pt}}

% --- Columnas ---------------------------------------------------------------------------
\newenvironment{columnas}{\begin{multicols*}{2}\raggedcolumns}{\end{multicols*}}

% --- Bloques (equivalen a los apartados del tema) ----------------------------------------
% Minutos sin decimales (2,5 → 2′30″): \tceemmss y \tiempo, de tcee-comun.sty

% \bloque[minutos]{título}: barra morada con el título y, si se da, los minutos del cante
% Sin \needspace: su pegamento elástico hacía que multicols cortara la columna
% antes de cada título y dejaba huecos de varias líneas al pie. Los títulos no
% quedan huérfanos porque detrás va \nopagebreak, las listas no admiten corte al
% empezar (beginpenalty) y \clubpenalty y \widowpenalty prohíben líneas sueltas.
\newcommand{\bloque}[2][]{\par\vspace{3pt}%
  \noindent\phantomsection\colorbox{tceemorado}{\parbox{\dimexpr\linewidth-2\fboxsep}{%
    \color{white}\bfseries\strut#2\if\relax\detokenize{#1}\relax\else\hfill{\mdseries\itshape\tceemmss{#1}}\fi}}%
  \par\nopagebreak\vspace{1pt}}
% \sub{título}: subapartado, en morado con raya fina. Las remisiones a un
% \bloque o \sub de la ficha son enlaces: \sub{I.2. Título\label{rep:I.2}} y en
% el texto \hyperref[rep:I.2]{I.2} (\phantomsection pone el ancla)
\newcommand{\sub}[1]{\par\vspace{2pt}%
  \noindent\phantomsection{\color{tceemorado}\bfseries#1}\par\nopagebreak\vspace{-0.45em}%
  \noindent{\color{tceemorado}\rule{\linewidth}{0.3pt}}\par\nopagebreak}
% Ojo: un \color en modo vertical deja un «whatsit» que convierte el \parskip
% siguiente en un punto de corte legal; por eso cada línea empieza con \noindent
% o \leavevmode (sin ello, un \sub podía quedar solo al pie de la columna).

% --- Listas compactas ---------------------------------------------------------------------
\setlist{itemsep=0pt,topsep=1pt,parsep=0pt,partopsep=0pt,leftmargin=0.9em,
  beginpenalty=10000,midpenalty=0,endpenalty=0}
\clubpenalty=10000 \widowpenalty=10000
\setlist[itemize,1]{label={\color{tceemorado}\tiny$\blacksquare$}}
\setlist[itemize,2]{label={\color{tceemorado}--},leftmargin=0.8em}
\setlist[itemize,3]{label={\color{tceemorado}\tiny$\circ$},leftmargin=0.8em}
\setlist[enumerate,1]{label={\color{tceemorado}\arabic*.},leftmargin=1.1em}

% --- Énfasis (\autor, \concepto, \vect: tcee-comun.sty) ----------------------------
% \vertema{3.A.12} es un enlace al tema citado (tcee-comun.sty); en la ficha el
% texto es solo «[3.A.12]», para ahorrar sitio
\renewcommand{\tcee@textovertema}[1]{[#1]}
\newcommand{\dato}[2]{\textbf{#1}{\color{tceegris}\,(#2)}}   % \dato{54,1 \% del PIB}{INE, 2025}

% --- Cajas -----------------------------------------------------------------------------------
\newtcolorbox{ideaclave}{enhanced,colback=tceesalvia,colframe=tceesalviaoscuro,
  boxrule=0.4pt,arc=1pt,left=3pt,right=3pt,top=1pt,bottom=1pt,fontupper=\itshape,before skip=2pt,after skip=2pt}
% La fórmula va siempre pegada a la línea que la presenta (no se separa de
% ella por un salto de columna o de página): before con \nopagebreak.
\newtcolorbox{formula}{enhanced,colback=tceemoradopalido,colframe=tceemoradopalido,
  boxrule=0pt,arc=1pt,left=2pt,right=2pt,top=0pt,bottom=0pt,
  before={\par\nopagebreak\vspace{2pt}\nopagebreak\noindent},after skip=2pt}
\newtcolorbox{trampa}{enhanced,breakable,colback=white,colframe=tceedorado,boxrule=0.4pt,leftrule=2pt,
  arc=0pt,left=3pt,right=3pt,top=1pt,bottom=1pt,before skip=2pt,after skip=2pt,
  title={Ojo en el test},fonttitle=\bfseries\color{tceedorado},coltitle=tceedorado,
  colbacktitle=white,attach title to upper={\ }}
% Gráfico pequeño del tema: \graficorepaso[ancho]{nombre}{pie breve}
\newcommand{\graficorepaso}[3][0.95\linewidth]{\par\vspace{2pt}{\centering
  \includegraphics[width=#1]{#2}\par\nopagebreak\leavevmode{\color{tceegris}\scriptsize\itshape#3}\par}\vspace{2pt}}
% Esquema del cante: una línea por apartado con sus minutos
\newcommand{\esquemacante}[1]{\begin{tcolorbox}[enhanced,colback=tceemoradopalido,colframe=tceemorado,
  boxrule=0.4pt,arc=1pt,left=3pt,right=3pt,top=1pt,bottom=1pt,before skip=2pt,after skip=3pt]#1\end{tcolorbox}}
% \apartadocante{I. ...}{10} y \subcante{1. ...}{3}; los minutos pueden ir vacíos
\newcommand{\tcee@minutos}[1]{\if\relax\detokenize{#1}\relax\hfill\else\dotfill{\color{tceemorado}\tceemmss{#1}}\fi}
\newcommand{\apartadocante}[2]{\par\noindent\textbf{#1}\tcee@minutos{#2}\par}
\newcommand{\subcante}[2]{\par\noindent\hspace*{0.8em}#1\tcee@minutos{#2}\par}
% (si una línea del esquema no cabe, se parte: conviene que los títulos sean cortos)
% Cronología: \hito{1915}{Slutsky: efecto sustitución y renta}
\newcommand{\hito}[2]{\par\noindent\makebox[2.4em][l]{\color{tceemorado}\bfseries#1}%
  \parbox[t]{\dimexpr\linewidth-2.4em}{#2}\par}


% \optim{…}{…}{…}{…} (problema de optimización) y \findemo (∎): tcee-comun.sty.

% --- Función clave y gráficos en pareja -------------------------------------------
% \funcionclave{C(\vect{w},q)=…}: la función central del tema, morada y recuadrada
% con el mismo estilo que en el tema (tcee-comun.sty), centrada y compacta (sin
% número). Va fuera de $…$; dentro puede ir \optim.
\tcbset{tcee funcion clave/.style={enhanced,nobeforeafter,colback=tceemoradopalido!70!white,
  colframe=tceemorado,colupper=tceemorado,boxrule=0.6pt,arc=1.5pt,left=4pt,right=4pt,top=2pt,bottom=2pt}}
\newcommand{\funcionclave}[1]{\par\nopagebreak\vspace{1pt}{\centering$\tcbhighmath[tcee funcion clave]{\displaystyle #1}$\par}\vspace{2pt}}
% Dos gráficos lado a lado: \pareja{nombre1}{pie1}{nombre2}{pie2}
\newcommand{\pareja}[4]{\par\vspace{2pt}\noindent
  \begin{minipage}[b]{0.49\linewidth}\graficorepaso[\linewidth]{#1}{#2}\end{minipage}\hfill
  \begin{minipage}[b]{0.49\linewidth}\graficorepaso[\linewidth]{#3}{#4}\end{minipage}\par}

\endinput
