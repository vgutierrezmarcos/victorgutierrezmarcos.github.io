% ==========================================================================
% tcee.sty — Estilo común de los temas del 3.º y 4.º ejercicio
% Oposición a Técnico Comercial y Economista del Estado
% Autor: Víctor Gutiérrez Marcos
%
% Reproduce la estética de los temas en Word y de victorgutierrezmarcos.es:
% Palatino, morado #5F2987, salvia #E2EFD9, cabecera con la fecha de la
% última actualización y apartados en banda morada.
%
% Uso (en el preámbulo de LyX o en un .tex):
%   \usepackage{tcee}
%   \tcetema[Teoría de la demanda del consumidor (I)]{3.A.8}{<título oficial completo>}
%   \tcefecha{10/10/2026}
%   \addbibresource{3A08.bib}
%
% Ficheros que hay que mantener a la par (si se añade una orden aquí, añadirla allí):
%   tcee-comun.sty (lo compartido con la ficha de repaso, tcee-repaso.sty),
%   pandoc-macros.tex, tcee.lua y construir-tema.py (web y Word) y tcee.module (LyX).
% Órdenes propias:
%   \autor{Marshall}, \concepto{…}, \vertema{3.A.9}, \vect{x}, \fuente{…},
%   \grafico[ancho]{nombre}; cajas notaopositor, anotaciones, ideaclave y
%   esquema; figuracaja y tablacaja (gráfico o tabla dentro de una caja).
%   \minutos{2,5}   tras el título de un apartado; entrada decimal, se ve 2′30″.
%   \tiempo{2,5}    minutos en el texto: «introducción, \tiempo{2,5}» → 2′30″.
%   \funcionclave{C(\vect{w},q)=\min_{\vect{z}}\{\vect{w}\cdot\vect{z}:F(\vect{z})\geq q\}}
%                   función central del tema, en display, morada y recuadrada;
%                   \funcionclave[eq:costes]{…} lleva número y se cita con \eqref.
%   $$\optim{\min}{\vect{z}}{\vect{w}\cdot\vect{z}}{F(\vect{z})\geq q\\ \vect{z}\geq\vect{0}}$$
%                   problema de optimización: objetivo arriba y «s.a.» con cada
%                   restricción (separadas por \\) en su línea, alineadas.
%                   También dentro de \funcionclave{\optim{…}{…}{…}{…}}.
%   \footnote{Texto.\graficonota{nombre}}
%                   gráfico pequeño (0,45 del ancho, centrado) en una nota al
%                   pie; \graficonota[0.35]{nombre} con otro ancho.
%   \findemo        ∎ de fin de demostración, a la derecha (fuera de las fórmulas).
%   \bibliografia   al final (página nueva, numeración B-1…).
% Páginas: el tema en 1…N, los anexos (tras \appendix) en A-1… y la
% bibliografía en B-1…; la portada dice cuántas tiene cada parte.
% ==========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tcee}[2026/10/10 Temas TCEE]

% --- Base común con la ficha de repaso (idioma, Palatino, colores, \tcetema,
% \tiempo, \autor, \concepto, \vect, \vertema, \optim, \findemo, licencia) ---
\RequirePackage{tcee-comun}

% --- Página -----------------------------------------------------------------
\RequirePackage[a4paper,top=2.6cm,bottom=2.4cm,left=2.2cm,right=2.2cm,
  headheight=26pt,footskip=1.2cm]{geometry}
\RequirePackage{setspace}
\setstretch{1.08}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45em}
% Control de líneas viudas y huérfanas: ningún párrafo deja una línea sola al pie
% o al principio de una página (tampoco antes o después de una ecuación ni con
% un guion de corte al final de página)
\clubpenalty=10000 \widowpenalty=10000 \displaywidowpenalty=10000
\predisplaypenalty=10000 \brokenpenalty=10000


% --- Paquetes generales -----------------------------------------------------
\RequirePackage{multirow}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{titlesec}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage[hang,flushmargin,bottom]{footmisc}% bottom: las notas siempre al pie, aunque la página tenga hueco
\RequirePackage{needspace}
% \hhline en vez de \cline en las tablas con \cellcolor: el color de la celda
% tapa las rayas de \cline, pero no las de \hhline.
\RequirePackage{hhline}
% En las celdas de las tablas, \newline empieza una línea nueva sin el \hfil que
% lleva normalmente, para que en las columnas centradas
% (>{\centering\arraybackslash}m{…}) y en \multirow{n}{=}{\centering …} cada
% línea quede centrada. En las columnas p{} y m{} sin centrar es lo mismo.
\newcommand{\tcee@saltocelda}{\ifhmode\par\fi}
\AtBeginEnvironment{tabular}{\let\newline\tcee@saltocelda}
\renewcommand{\footnotelayout}{\footnotesize}
\renewcommand{\thefootnote}{\arabic{footnote}}


