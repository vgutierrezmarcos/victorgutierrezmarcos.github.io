% --- Título del tema --------------------------------------------------------
% (Víctor, 11/11/2026) El título se compone en el mínimo de líneas posible y con
% las líneas equilibradas (sin una palabra suelta al final): se busca la caja
% más estrecha en la que el título sigue cabiendo en ese mínimo de líneas
% (búsqueda binaria sobre la anchura, contando las líneas con \prevgraf).
% El bloque reserva siempre la altura de tres líneas de \large y centra el
% título en ella, para que la introducción empiece a la misma altura en todos
% los temas; si el título necesitara más de tres líneas, baja a \normalsize y,
% si aún no cabe, a \small. Corte manual opcional en un título rebelde:
% \cortetitulo dentro del título de \tcetema (en la web y Word es un espacio);
% entonces no se equilibra y se respeta el corte.
\newlength{\tcee@ancho}
\newlength{\tcee@maximo}
\newlength{\tcee@bajo}
\newlength{\tcee@alto}
\newlength{\tcee@reserva}
\newcount\tcee@lineas
\newcount\tcee@minimo
\newif\iftcee@corte
\newcommand{\tcee@tamtitulo}{\large}
\newcommand{\tcee@formatotitulo}{\tcee@tamtitulo\bfseries\color{tceemorado}\hyphenpenalty=10000\exhyphenpenalty=10000}
\newcommand{\tcee@textotitulo}{\MakeUppercase{\tcee@codigo:\ \tcee@titulo}}
% Compone el título en la anchura #1 (caja 0) y deja sus líneas en \tcee@lineas
\newcommand{\tcee@probar}[1]{%
  % el grupo interior hace que el \color se cierre dentro de la caja (si no,
  % el cierre queda fuera y todo el tema sale en morado)
  \setbox0\vbox{\begingroup\hsize=#1\relax\centering\tcee@formatotitulo\tcee@textotitulo\par
    \global\tcee@lineas=\prevgraf\endgroup}}
\newcommand{\tcee@buscarancho}{%
    \setlength{\tcee@bajo}{0.3\tcee@maximo}\setlength{\tcee@alto}{\tcee@maximo}%
    \loop\ifdim\dimexpr\tcee@alto-\tcee@bajo\relax>0.5pt
      \setlength{\tcee@ancho}{\dimexpr(\tcee@alto+\tcee@bajo)/2\relax}%
      \tcee@probar{\tcee@ancho}%
      \ifnum\tcee@lineas>\tcee@minimo \setlength{\tcee@bajo}{\tcee@ancho}\else\setlength{\tcee@alto}{\tcee@ancho}\fi
    \repeat
    % un poco de holgura sobre la anchura mínima, para que no quede apretado
    \setlength{\tcee@ancho}{\dimexpr\tcee@alto+0.8em\relax}%
    \ifdim\tcee@ancho>\tcee@maximo \setlength{\tcee@ancho}{\tcee@maximo}\fi
}
\newcommand{\tceetitulo}{%
  \thispagestyle{tceeprimera}%
  \begingroup
  \setlength{\tcee@maximo}{0.92\textwidth}%
  \global\tcee@cortefalse
  \sbox0{\protected\def\cortetitulo{\global\tcee@cortetrue}\tcee@formatotitulo\tcee@textotitulo}%
  \tcee@probar{\tcee@maximo}%
  \ifnum\tcee@lineas>3 \renewcommand{\tcee@tamtitulo}{\normalsize}\tcee@probar{\tcee@maximo}\fi
  \ifnum\tcee@lineas>3 \renewcommand{\tcee@tamtitulo}{\small}\tcee@probar{\tcee@maximo}\fi
  \tcee@minimo=\tcee@lineas
  \setlength{\tcee@ancho}{\tcee@maximo}%
  % (la búsqueda va en una macro: \repeat es \fi y desequilibra el condicional
  % cuando se salta, p. ej. con \cortetitulo)
  \iftcee@corte\else\ifnum\tcee@minimo>1 \tcee@buscarancho\fi\fi
  \tcee@probar{\tcee@ancho}%
  % altura reservada: tres líneas de \large
  {\large\global\tcee@reserva=\dimexpr 2\baselineskip+\ht\strutbox+\dp\strutbox\relax}%
  \begin{center}
    \vbox to \tcee@reserva{\vss\hbox to\linewidth{\hss\box0\hss}\vss}\par
    \vspace{0.5em}{\color{tceemorado}\rule{0.6\textwidth}{0.8pt}}\par
    \vspace{0.3em}\tcee@lineapaginas
    \vspace{0.15em}\tcee@linealicencia
  \end{center}
  \endgroup
  \vspace{1.6em}%
}

% --- Apartados ---------------------------------------------------------------
% Jerarquía de los títulos (Víctor, 11/11/2026): de más a menos peso, sin que un
% nivel inferior destaque más que uno superior, y lo mismo en la web (tema.css)
% y en Word (crear-reference-docx.py):
% 1 \section       → banda morada, versales blancas en negrita (INTRODUCCIÓN, I. …)
% 2 \subsection    → I.1. grande, morado, negrita y subrayado con una raya fina
% 3 \subsubsection → I.1.1. tamaño del texto, morado, negrita; sangría 1,2 em
% 4 \paragraph     → sin número, morado oscuro, negrita cursiva; sangría 2,4 em
% 5 \subparagraph  → sin número, morado oscuro, cursiva; sangría 3,6 em
% (los bloques a), b)… e i), ii)… de un modelo llevan la letra a mano: CRITERIOS)
% Todos los títulos van sin justificar y sin cortar palabras con guion: si no
% caben en una línea, se cortan entre palabras, y la segunda línea queda
% sangrada bajo el texto (no bajo el número). Para elegir el punto de corte
% (tras «:», antes de «y»…): \cortetitulo, que en el PDF es un salto de línea y
% en los marcadores, la web, el Word y el esquema un espacio:
%   \subsection{Los hechos de Kaldor:\cortetitulo{} ¿los reproduce el modelo?}
% (\newline hace lo mismo en el PDF, pero en Word es un salto de línea.)
% Ningún título puede quedar al pie de una página: antes de cada uno se pide
% sitio para el título y unas líneas de texto (\needspace) y los minutos del
% cante no permiten salto. Tampoco puede haber salto entre dos títulos seguidos,
% y el segundo de dos títulos seguidos no añade su espacio de antes (\tcee@antes).
\setcounter{secnumdepth}{3}
\renewcommand{\thesection}{\Roman{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}
\DeclareRobustCommand{\cortetitulo}{\ifvmode\else\newline\fi}
% Sin guiones ni justificado en los títulos
\newcommand{\tcee@singuiones}{\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000\relax}
% Espacio antes de un título: el normal, o casi nada si sigue a otro título
% (\if@nobreak: lo deja activo el título anterior hasta el primer párrafo)
\newcommand{\tcee@antes}[1]{\if@nobreak 0.25em\else #1\fi}
\titleformat{\section}[block]{\normalfont}{}{0pt}{\tcee@banda}
% Si el título no cabe en una línea, la segunda va sangrada bajo el texto (no
% bajo el número) y sin justificar
\newcommand{\tcee@banda}[1]{%
  \colorbox{tceemorado}{\parbox{\dimexpr\textwidth-2\fboxsep}{%
    \large\bfseries\color{white}\tcee@singuiones
    \setbox0\hbox{\thesection.\ }\hangindent=\wd0\hangafter=1
    \strut\box0\MakeUppercase{#1}\strut}}}
% Introducción y Conclusión: \section*{Introducción}, banda sin número. También
% van a los marcadores del PDF (\phantomsection + \addcontentsline).
\titleformat{name=\section,numberless}[block]{\normalfont}{}{0pt}{\tcee@bandasin}
\newcommand{\tcee@bandasin}[1]{\phantomsection\addcontentsline{toc}{section}{#1}%
  \colorbox{tceemorado}{\parbox{\dimexpr\textwidth-2\fboxsep}{%
    \large\bfseries\color{white}\tcee@singuiones\strut\MakeUppercase{#1}\strut}}}
\titlespacing*{\section}{0pt}{\tcee@antes{1.4em}}{0.8em}
\titleformat{\subsection}[hang]{\normalfont\large\bfseries\color{tceemorado}\nobreak\tcee@singuiones}{\thesubsection.}{0.5em}{}
  [\nobreak\vspace{-0.15em}{\color{tceemorado}\nobreak\titlerule[0.5pt]}\nobreak]
\titlespacing*{\subsection}{0pt}{\tcee@antes{1.3em}}{0.5em}
\titleformat{\subsubsection}[hang]{\normalfont\bfseries\color{tceemorado}\nobreak\tcee@singuiones}{\thesubsubsection.}{0.5em}{}
\titlespacing*{\subsubsection}{1.2em}{\tcee@antes{0.9em}}{0.3em}
\titleformat{\paragraph}[hang]{\normalfont\bfseries\itshape\color{tceemoradooscuro}\nobreak\tcee@singuiones}{}{0pt}{}
\titlespacing*{\paragraph}{2.4em}{\tcee@antes{0.7em}}{0.2em}
% Niveles 4 y 5 para la estructura de cada modelo (CRITERIOS, «Estructura de un
% modelo»): \paragraph{a) Idea}, \paragraph{b) Modelo} y dentro
% \subparagraph{i) Supuestos}, \subparagraph{ii) Desarrollo}… (letras a mano,
% para que salgan igual en la web y en Word).
\titleformat{\subparagraph}[hang]{\normalfont\itshape\color{tceemoradooscuro}\nobreak\tcee@singuiones}{}{0pt}{}
\titlespacing*{\subparagraph}{3.6em}{\tcee@antes{0.5em}}{0.15em}
% Un título que sigue directamente a otro (\if@nobreak) no pide sitio: el
% \Needspace forzaría el salto justo entre los dos. Así nunca hay salto de
% página entre un título y lo que le sigue, aunque sea otro título: si el
% bloque de títulos y sus primeras líneas no cabe, pasa entero a la página
% siguiente. Por lo mismo, cada \color de un título va seguido de \nobreak: el
% cambio de color deja en la lista vertical un nodo tras el que TeX podría
% cortar (y como la página no estira, a igual coste elige el último corte).
\newcommand{\tcee@sitio}[1]{\if@nobreak\else\Needspace{#1\baselineskip}\fi}
\preto\section{\tcee@sitio{8}}
\preto\subsection{\tcee@sitio{6}}
\preto\subsubsection{\tcee@sitio{5}}
\preto\paragraph{\tcee@sitio{4}}
\preto\subparagraph{\tcee@sitio{3}}


% Minutos del cante: \minutos{6} justo después del título del apartado. La
% entrada es decimal (\minutos{2,5}, para que los scripts sumen), pero se
% muestra sin decimales: 2,5 → 2′30″ (\tceemmss de tcee-comun.sty). En el
% texto, \tiempo{2,5} (→ 2′30″), nunca «2,5 minutos».
\newcommand{\minutos}[1]{\par\nopagebreak\vspace*{-0.9em}\nopagebreak
  \hfill{\scriptsize\itshape\color{tceegris}\tceemmss{#1}}\par\nopagebreak\vspace{-0.2em}\@afterheading}

% --- Listas (viñetas como en Word: ■, –, o) ---------------------------------
% beginpenalty=10000: una lista no puede separarse de la línea anterior (el
% párrafo o la viñeta que la introduce, que con \widowpenalty arrastra además su
% penúltima línea): nunca hay salto de página entre un párrafo y el primero de
% nivel inferior que lo sigue (CRITERIOS.md). En Word lo hace construir-tema.py
% con «conservar con el siguiente».
\setlist{itemsep=0.15em,topsep=0.3em,parsep=0.15em,beginpenalty=10000}
\setlist[itemize,1]{label={\color{tceemorado}\scriptsize$\blacksquare$},leftmargin=1.4em}
\setlist[itemize,2]{label={\color{tceemorado}--},leftmargin=1.4em}
\setlist[itemize,3]{label={\color{tceemorado}\footnotesize$\circ$},leftmargin=1.4em}
\setlist[itemize,4]{label={\color{tceemorado}\tiny$\blacktriangleright$},leftmargin=1.4em}
\setlist[enumerate,1]{label={\color{tceemorado}\arabic*.},leftmargin=1.6em}
\setlist[enumerate,2]{label={\color{tceemorado}\roman*.},leftmargin=1.6em}

% --- Énfasis propios y enlaces a otros temas: en tcee-comun.sty ---------------
% \autor{Marshall} (versalitas), \concepto{…} (negrita), \vect{x} (flecha) y
% \vertema{3.A.12} (enlace gris «[ver tema 3.A.12]»).

% --- Fórmulas: funciones clave y problemas de optimización ------------------------
% (el estilo «tcee funcion clave» está en tcee-comun.sty, compartido con la ficha)
% \funcionclave{C(\vect{w},q)=\min_{\vect{z}}\ \vect{w}\cdot\vect{z}} → ecuación en
% display, centrada, en morado y recuadrada (las funciones centrales del tema,
% las que se mantienen en la pizarra). Con etiqueta y número:
% \funcionclave[eq:costes]{…} (se cita con \eqref{eq:costes}). Va sola, fuera
% de $$…$$; dentro puede ir \optim.
\NewDocumentCommand{\funcionclave}{om}{%
  \IfNoValueTF{#1}%
    {\[\tcbhighmath[tcee funcion clave]{\displaystyle #2}\]}%
    {\begin{equation}\tcbhighmath[tcee funcion clave]{\displaystyle #2}\label{#1}\end{equation}}}
% \optim{\max}{\vect{z}}{objetivo}{restr1\\ restr2} (problema de optimización con las
% restricciones debajo) y \findemo (∎) están en tcee-comun.sty.
% \graficonota{nombre} → gráfico pequeño (0,45 del ancho, centrado) dentro de
% una nota al pie: \footnote{Texto de la nota.\graficonota{curva-aprendizaje}}.
% Con otro ancho: \graficonota[0.35]{nombre}.
% La nota con gráfico no se parte entre 2 páginas (texto en una y gráfico en la
% otra): sin cortes entre sus líneas ni antes del gráfico, va entera a donde quepa.
\newcommand{\graficonota}[2][0.45]{{\interlinepenalty\@M\par}\nobreak\vspace{3pt}\nobreak
  {\centering\includegraphics[width=#1\linewidth]{#2}\par}\vspace{1pt}}


% --- Cajas ----------------------------------------------------------------------
% La primera línea de una caja hace de título: nunca queda sola al pie de una
% página con el resto de la caja en la siguiente (Víctor, 12/11/2026). Al abrir
% la caja (tcee primera linea) se marca su primer párrafo: no admite salto tras
% su primera línea (\vadjust{\nobreak}) ni entre él y lo que le sigue (una
% tabla o un gráfico de figuracaja, una lista, otro párrafo). Si el primer
% párrafo y lo siguiente no caben juntos, la caja se corta más abajo o, si
% nada cabe, empieza en la página siguiente (tcolorbox no deja la parte vacía).
% Es una marca global (para que no la deshaga un grupo como \textbf{…} con que
% empiece el párrafo); la consume el primer párrafo que se abre dentro.
\newif\iftcee@primerpar
\AddToHook{para/begin}{\iftcee@primerpar\vadjust{\nobreak}\fi}
\AddToHook{para/after}{\iftcee@primerpar\global\tcee@primerparfalse\nobreak\fi}
\tcbset{tcee primera linea/.style={before upper pre={\global\tcee@primerpartrue},
  after upper pre={\global\tcee@primerparfalse}}}
% Nota al opositor: consejo útil para el cante (sustituye a la caja amarilla
% con texto rojo de los Word antiguos).
\newtcolorbox{notaopositor}[1][]{enhanced,breakable,
  colback=tceemoradopalido,colframe=tceemorado,boxrule=0pt,leftrule=3pt,arc=1pt,
  fontupper=\small,left=8pt,right=8pt,top=5pt,bottom=5pt,
  title={\textsc{Nota al opositor}},coltitle=tceemorado,fonttitle=\small\bfseries,
  attach title to upper={\ \textbullet\ },tcee primera linea,#1}
% Anotaciones: lecturas recomendadas, enlaces y material complementario.
\newtcolorbox{anotaciones}[1][]{enhanced,breakable,
  colback=tceegrisclaro!55,colframe=tceegris,boxrule=0.4pt,arc=1pt,
  fontupper=\footnotesize,left=8pt,right=8pt,top=4pt,bottom=4pt,tcee primera linea,#1}
% Idea clave: frase que conviene decir tal cual en el cante.
\newtcolorbox{ideaclave}[1][]{enhanced,breakable,
  colback=tceesalvia,colframe=tceesalviaoscuro,boxrule=0.6pt,arc=2pt,
  fontupper=\itshape,left=8pt,right=8pt,top=5pt,bottom=5pt,tcee primera linea,#1}
% Esquema del tema (para la pizarra)
\newtcolorbox{esquema}[1][]{enhanced,breakable,
  colback=tceecrema,colframe=tceemorado,boxrule=0.6pt,arc=2pt,
  title={Esquema del tema},fonttitle=\bfseries,colbacktitle=tceemorado,
  fontupper=\small,before upper app={\tcee@esqinicio},#1}
% Minutos orientativos de cada parte en el esquema, a la derecha y en gris,
% solo en la línea de la introducción, de cada apartado y de la conclusión:
% «I. Título\esqtiempo{11}\\». Un título por línea (CRITERIOS §2).
% Los minutos van en una columna fija a la derecha (Víctor, 12/11/2026): todas
% las líneas dejan libre ese hueco (\rightskip), así que un título largo se
% parte antes y los minutos quedan en su última línea, nunca solos debajo. Cada
% línea del esquema (lo que va entre \\) es un párrafo con sangría francesa: si
% se parte, la segunda línea va sangrada bajo el texto (\tcee@esqhang más la
% sangría \hspace* con que empiece la línea).
\newdimen\tcee@esqancho
\newdimen\tcee@esqhang
\newif\iftcee@enesquema
\newcommand{\tcee@esqlinea}{\noindent\hangindent\tcee@esqhang\hangafter\@ne\ignorespaces}
\newcommand{\tcee@esqcr}[1][0pt]{\par\vspace{#1}\tcee@esqlinea}
\newcommand{\tcee@esqsangria}[1]{\hskip#1\relax\advance\hangindent#1\relax}
\newcommand{\tcee@esqinicio}{%
  \tcee@enesquematrue
  \settowidth{\tcee@esqancho}{\scriptsize\itshape\tceemmss{88,5}}%
  \advance\tcee@esqancho 1em\relax
  \settowidth{\tcee@esqhang}{III.\ }%
  \parindent\z@\parskip\z@
  \rightskip\tcee@esqancho plus 1fil\relax
  \hyphenpenalty\@M\exhyphenpenalty\@M
  \def\\{\@ifstar\tcee@esqcr\tcee@esqcr}%
  \def\hspace{\@ifstar\tcee@esqsangria\tcee@esqsangria}%
  \tcee@esqlinea}
\newcommand{\esqtiempo}[1]{\iftcee@enesquema
    \unskip\nobreak\hfill\rlap{\hbox to\tcee@esqancho{\hfill\scriptsize\itshape\color{tceegris}\tceemmss{#1}}}%
  \else\hfill{\scriptsize\itshape\color{tceegris}\tceemmss{#1}}\fi}
% Cada línea del esquema enlaza con su apartado (Víctor, 11/11/2026). No hay
% que escribirlo: construir-tema.py (comun.enlazar_esquema) lo añade en la copia
% de _trabajo/, por el orden de las líneas (I., II.…; 1., 2.… bajo cada una;
% Introducción y Conclusión por su nombre) o por el \ref{} con que empiezan:
% «\esqenlace{sec:x}{I. Título}\esqtiempo{7}». El texto conserva su color.
\newcommand{\esqenlace}[2]{\begingroup\hypersetup{linkcolor=black}\hyperref[#1]{#2}\endgroup}

% --- Figuras y tablas ---------------------------------------------------------
% Título encima («Gráfico 1.– …») y fuente obligatoria debajo con \fuente{…}.
\captionsetup{font=small,labelfont={bf,color=tceemorado},labelsep=endash,
  justification=centering,position=top,skip=4pt}
\captionsetup[figure]{name=Gráfico}
\captionsetup[table]{name=Tabla}
% Gráficos, figuras e imágenes se numeran por separado (Víctor, 11 y 13/11/2026):
%   figure     → «Gráfico n»: gráficos de verdad, dibujados en graficos/*.tex
%                (ejes, curvas, datos; diagramas analíticos: cruz keynesiana,
%                caja de Edgeworth, árbol de decisión de un juego…);
%   infografia → «Figura n»: esquemas e infografías propias, también dibujados
%                en graficos/*.tex, que no son un gráfico: mapas conceptuales,
%                cajas y flechas, cascadas de cuentas, líneas de tiempo, cuadros
%                comparativos dibujados, esquemas de canales o de instituciones;
%   imagen     → «Imagen n»: solo archivos pegados tal cual (jpg, png, o un pdf
%                sin .tex fuente: fotos, capturas, láminas, figuras de otros).
% Se escriben igual (\caption, \label, \grafico, \fuente); las etiquetas son
% fig:… (gráfico), figu:… (figura) e img:… (imagen) y se citan con
% «gráfico~\ref{fig:…}», «figura~\ref{figu:…}» e «imagen~\ref{img:…}».
% Dentro de una caja: figuracaja (gráfico), infografiacaja e imagencaja.
% En la web y en Word, construir-tema.py convierte figuras e imágenes en
% figure con la marca tceefigura o tceeimagen y tcee.lua les pone «Figura n.–»
% o «Imagen n.–».
\DeclareCaptionType[fileext=loi,placement={htbp}]{imagen}[Imagen][Lista de imágenes]
\DeclareCaptionType[fileext=lfg,placement={htbp}]{infografia}[Figura][Lista de figuras]
\newcommand{\fuente}[1]{\par\vspace{2pt}{\centering\footnotesize\itshape Fuente: #1\par}}
% (Víctor, 12/11/2026) Ningún gráfico se sale de la página ni deja una página
% en blanco: la altura se limita al 78 % de la caja de texto (queda sitio para
% el título y la fuente) y se conserva la proporción.
\newcommand{\grafico}[2][0.75\textwidth]{%
  \includegraphics[width=#1,height=0.78\textheight,keepaspectratio]{#2}}
\graphicspath{{graficos/}{../graficos/}}
% Gráfico o tabla dentro de una caja (anotaciones, ideaclave…): los flotantes
% (figure, table) no pueden ir dentro de una tcolorbox, así que se usan
% figuracaja y tablacaja, con lo mismo dentro (\caption, \label, \grafico o
% tabular, \fuente) y la misma numeración «Gráfico n»/«Tabla n». Van en un
% bloque que no se parte entre páginas. Para la web y Word, construir-tema.py
% los convierte en figure y table (pandoc-macros.tex).
%   \begin{anotaciones} … \begin{figuracaja}\caption{…}\label{fig:x}
%   \grafico[0.5\textwidth]{x}\fuente{…}\end{figuracaja} … \end{anotaciones}
\newcommand{\tcee@encaja}[1]{\par\addvspace{6pt}\noindent\begin{minipage}{\linewidth}%
  \centering\normalsize\captionsetup{type=#1}}
\newcommand{\tcee@fincaja}{\end{minipage}\par\addvspace{6pt}}
\newenvironment{figuracaja}{\tcee@encaja{figure}}{\tcee@fincaja}
\newenvironment{tablacaja}{\tcee@encaja{table}}{\tcee@fincaja}
\newenvironment{imagencaja}{\tcee@encaja{imagen}}{\tcee@fincaja}
\newenvironment{infografiacaja}{\tcee@encaja{infografia}}{\tcee@fincaja}

% --- Notas al pie ---------------------------------------------------------------
\renewcommand{\footnoterule}{{\color{tceemorado}\hrule width 0.3\textwidth height 0.4pt}\vspace{3pt}}
\setlength{\footnotesep}{0.8\baselineskip}
% Nota que sigue en la página siguiente: flecha morada en el margen, al final de
% la parte que queda en esta (como en los Word antiguos). En la rutina de salida,
% \insertpenalties cuenta las notas (o trozos de nota) que pasan a la página siguiente.
\AtBeginDocument{%
  \let\tcee@makecol\@makecol
  \def\@makecol{%
    \ifnum\insertpenalties>\z@\ifvoid\footins\else
      \setbox\footins\vbox{\unvbox\footins\nointerlineskip
        \vbox to\z@{\vss\hbox to\hsize{\hfill\rlap{\kern4pt\raise2.5pt\hbox{\normalfont\small
          \color{tceemorado}$\hookrightarrow$}}}}}%
    \fi\fi
    \tcee@makecol}}

% --- Bibliografía ---------------------------------------------------------------
\RequirePackage[backend=biber,style=authoryear-comp,maxcitenames=2,uniquename=false,
  uniquelist=false,dashed=false,autocite=inline,sorting=nyt]{biblatex}
\DeclareFieldFormat{urldate}{(consulta: #1)}
\renewcommand*{\nameyeardelim}{\addcomma\space}
% Apellidos en versalitas en las citas del texto (no en la bibliografía)
\AtEveryCite{\renewcommand*{\mkbibnamefamily}[1]{\textsc{#1}}}
% La bibliografía va al final, después de los anexos, en página nueva
\newcommand{\bibliografia}{\tcee@nuevaparte{bib}{B}\printbibliography[heading=bibliography,title={Bibliografía}]}
% URL partibles en cualquier letra o número (si no, las largas se salen del margen)
\setcounter{biburlnumpenalty}{9000}
\setcounter{biburlucpenalty}{9000}
\setcounter{biburllcpenalty}{9000}

% --- Hiperenlaces (al final) -----------------------------------------------------
\RequirePackage[unicode]{hyperref}
\hypersetup{colorlinks=true,linkcolor=tceemorado,urlcolor=tceemoradooscuro,citecolor=tceemoradooscuro}
% numbered: los marcadores llevan el número del apartado («I. …», «I.1. …»,
% «A. …»), como la web y el Word (Víctor, 19/10/2026)
\RequirePackage[numbered]{bookmark}
% En los marcadores del PDF, el \newline con que se cortan los títulos largos
% es un espacio (si no, hyperref lo quita y pega las palabras: «empresasy») y
% el número va seguido de punto y espacio
\pdfstringdefDisableCommands{\def\newline{ }\def\cortetitulo{ }\def\numberline#1{#1.\ }}
