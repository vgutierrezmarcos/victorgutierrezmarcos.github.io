\pagestyle{tcee}

% --- Título del tema --------------------------------------------------------
% Las líneas del título salen equilibradas: se mide el título, se calcula
% cuántas líneas necesita y se compone en una caja de 1/n de su anchura (con
% un poco de holgura para que quepan las palabras), centrada.
\newlength{\tcee@ancho}
\newlength{\tcee@maximo}
\newcount\tcee@lineas
\newcommand{\tcee@formatotitulo}{\large\bfseries\color{tceemorado}\hyphenpenalty=10000\exhyphenpenalty=10000}
\newcommand{\tceetitulo}{%
  \thispagestyle{tceeprimera}%
  \begingroup
  \setlength{\tcee@maximo}{0.92\textwidth}%
  \sbox0{\tcee@formatotitulo\MakeUppercase{\tcee@codigo:\ \tcee@titulo}}%
  \tcee@lineas=\numexpr\wd0/\tcee@maximo\relax
  \ifdim\tcee@lineas\tcee@maximo<\wd0 \advance\tcee@lineas by 1 \fi
  \ifnum\tcee@lineas<1 \tcee@lineas=1 \fi
  \setlength{\tcee@ancho}{\dimexpr\wd0/\tcee@lineas+2.2em\relax}%
  \ifdim\tcee@ancho>\textwidth \setlength{\tcee@ancho}{\textwidth}\fi
  \begin{center}
    \parbox{\tcee@ancho}{\centering\tcee@formatotitulo\MakeUppercase{\tcee@codigo:\ \tcee@titulo}\par}\par
    \vspace{0.5em}{\color{tceemorado}\rule{0.6\textwidth}{0.8pt}}\par
    \vspace{0.3em}\tcee@lineapaginas
  \end{center}
  \endgroup
  \vspace{1.6em}%
}

% --- Apartados ---------------------------------------------------------------
% Cada nivel se distingue a simple vista (y lo mismo en la web y en Word):
% \section       → banda morada con texto blanco (INTRODUCCIÓN, I. …)
% \subsection    → I.1. grande, morado, negrita y subrayado con una raya fina
% \subsubsection → I.1.1. sangrado 1,2 em, morado, cursiva (sin negrita)
% \paragraph     → sangrado 2,4 em, cursiva gris oscura, sin número
% Ningún título puede quedar al pie de una página: antes de cada uno se pide
% sitio para el título y unas líneas de texto (\needspace) y los minutos del
% cante no permiten salto.
\setcounter{secnumdepth}{3}
\renewcommand{\thesection}{\Roman{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}
\titleformat{\section}[block]{\normalfont}{}{0pt}{\tcee@banda}
% Si el título no cabe en una línea, la segunda va sangrada bajo el texto (no
% bajo el número) y sin justificar; para cortar en un sitio concreto: \newline.
\newcommand{\tcee@banda}[1]{%
  \colorbox{tceemorado}{\parbox{\dimexpr\textwidth-2\fboxsep}{%
    \large\bfseries\color{white}\raggedright
    \setbox0\hbox{\thesection.\ }\hangindent=\wd0\hangafter=1
    \strut\box0\MakeUppercase{#1}\strut}}}
% Introducción y Conclusión: \section*{Introducción}, banda sin número
\titleformat{name=\section,numberless}[block]{\normalfont}{}{0pt}{\tcee@bandasin}
\newcommand{\tcee@bandasin}[1]{%
  \colorbox{tceemorado}{\parbox{\dimexpr\textwidth-2\fboxsep}{%
    \large\bfseries\color{white}\raggedright\strut\MakeUppercase{#1}\strut}}}
\titlespacing*{\section}{0pt}{1.4em}{0.8em}
\titleformat{\subsection}{\normalfont\large\bfseries\color{tceemorado}}{\thesubsection.}{0.5em}{}
  [\vspace{-0.15em}{\color{tceemorado}\titlerule[0.5pt]}]
\titlespacing*{\subsection}{0pt}{1.3em}{0.5em}
\titleformat{\subsubsection}{\normalfont\itshape\color{tceemorado}}{\upshape\thesubsubsection.}{0.5em}{}
\titlespacing*{\subsubsection}{1.2em}{0.9em}{0.3em}
\titleformat{\paragraph}{\normalfont\itshape\color{tceemoradooscuro}}{}{0pt}{}
\titlespacing*{\paragraph}{2.4em}{0.7em}{0.2em}
% Niveles 4 y 5 para la estructura de cada modelo (CRITERIOS, «Estructura de un
% modelo»): \paragraph{a) Idea}, \paragraph{b) Modelo} y dentro
% \subparagraph{i) Supuestos}, \subparagraph{ii) Desarrollo}… (letras a mano,
% para que salgan igual en la web y en Word).
\setcounter{secnumdepth}{3}
\titleformat{\subparagraph}{\normalfont\small\bfseries\color{tceemoradooscuro}}{}{0pt}{}
\titlespacing*{\subparagraph}{3.6em}{0.5em}{0.15em}
\preto\section{\Needspace{8\baselineskip}}
\preto\subsection{\Needspace{6\baselineskip}}
\preto\subsubsection{\Needspace{5\baselineskip}}
\preto\paragraph{\Needspace{4\baselineskip}}
\preto\subparagraph{\Needspace{3\baselineskip}}


% Minutos del cante: \minutos{6} justo después del título del apartado. La
% entrada es decimal (\minutos{2,5}, para que los scripts sumen), pero se
% muestra sin decimales: 2,5 → 2′30″, 26,5 → 26′30″, 1 → 1′ (\tceemmss).
% En el texto, los minutos se escriben con \tiempo{2,5} (→ 2′30″), nunca «2,5
% minutos».
\ExplSyntaxOn
\cs_if_exist:NF \tceemmss
  {
    \tl_new:N \l__tcee_mmss_tl
    \int_new:N \l__tcee_mmss_int
    \cs_new_protected:Npn \tceemmss #1
      {
        \tl_set:Nx \l__tcee_mmss_tl { \tl_trim_spaces:n {#1} }
        \tl_replace_all:Nnn \l__tcee_mmss_tl { , } { . }
        \regex_match:nVTF { \A \d+ (\.\d+)? \Z } \l__tcee_mmss_tl
          {
            \int_set:Nn \l__tcee_mmss_int { \fp_eval:n { round ( ( \l__tcee_mmss_tl ) * 60 ) } }
            \int_eval:n { \int_div_truncate:nn { \l__tcee_mmss_int } { 60 } }
            \ensuremath { \sp { \prime } }
            \int_compare:nNnF { \int_mod:nn { \l__tcee_mmss_int } { 60 } } = { 0 }
              {
                \int_compare:nNnT { \int_mod:nn { \l__tcee_mmss_int } { 60 } } < { 10 } { 0 }
                \int_eval:n { \int_mod:nn { \l__tcee_mmss_int } { 60 } }
                \ensuremath { \sp { \prime\prime } }
              }
          }
          { #1 }
      }
  }
\ExplSyntaxOff
\newcommand{\minutos}[1]{\par\nopagebreak\vspace*{-0.9em}\nopagebreak
  \hfill{\scriptsize\itshape\color{tceegris}\tceemmss{#1}}\par\nopagebreak\vspace{-0.2em}\@afterheading}
\newcommand{\tiempo}[1]{\mbox{\tceemmss{#1}}}

% --- Listas (viñetas como en Word: ■, –, o) ---------------------------------
% beginpenalty=10000: una lista no puede separarse de la línea anterior (el
% párrafo o la viñeta que la introduce, que con \widowpenalty arrastra además su
% penúltima línea): nunca hay salto de página entre un párrafo y el primero de
% nivel inferior que lo sigue (CRITERIOS.md). En Word lo hace construir-tema.py
% con «conservar con el siguiente».
\setlist{itemsep=0.15em,topsep=0.3em,parsep=0.15em,beginpenalty=10000}
\setlist[itemize,1]{label={\color{tceemorado}\scriptsize$\blacksquare$},leftmargin=1.4em}
\setlist[itemize,2]{label={\color{tceemorado}--},leftmargin=1.4em}
\setlist[itemize,3]{label={\color{tceemorado}\footnotesize$\circ$},leftmargin=1.4em}
\setlist[itemize,4]{label={\color{tceemorado}\tiny$\blacktriangleright$},leftmargin=1.4em}
\setlist[enumerate,1]{label={\color{tceemorado}\arabic*.},leftmargin=1.6em}
\setlist[enumerate,2]{label={\color{tceemorado}\roman*.},leftmargin=1.6em}

% --- Énfasis propios ----------------------------------------------------------
% Personas: apellido en versalitas SIEMPRE que se nombra a alguien en el texto
% (\autor{Marshall}); el nombre de pila y el año van en redonda. Las citas
% (\textcite, \parencite) ya ponen el apellido en versalitas (abajo).
\newcommand{\autor}[1]{\textsc{#1}}                        % \autor{Marshall} (1890)
% Vectores: flecha encima (\vect{x}, \vect{p}); los escalares sin flecha.
\providecommand{\vect}[1]{\vec{#1}}
\newcommand{\concepto}[1]{\textbf{#1}}                     % término clave
\newcommand{\vertema}[1]{{\color{tceegris}[ver tema #1]}}  % referencia cruzada

% --- Fórmulas: funciones clave y problemas de optimización ------------------------
% \funcionclave{C(\vect{w},q)=\min_{\vect{z}}\ \vect{w}\cdot\vect{z}} → ecuación en
% display, centrada, en morado y recuadrada (las funciones centrales del tema,
% las que se mantienen en la pizarra). Con etiqueta y número:
% \funcionclave[eq:costes]{…} (se cita con \eqref{eq:costes}). Va sola, fuera
% de $$…$$; dentro puede ir \optim.
\tcbset{tcee funcion clave/.style={enhanced,nobeforeafter,colback=tceemoradopalido!70!white,
  colframe=tceemorado,colupper=tceemorado,boxrule=0.8pt,arc=2pt,left=8pt,right=8pt,top=4pt,bottom=4pt}}
\NewDocumentCommand{\funcionclave}{om}{%
  \IfNoValueTF{#1}%
    {\[\tcbhighmath[tcee funcion clave]{\displaystyle #2}\]}%
    {\begin{equation}\tcbhighmath[tcee funcion clave]{\displaystyle #2}\label{#1}\end{equation}}}
% \optim{\max}{\vect{z}}{p\,F(\vect{z})-\vect{w}\cdot\vect{z}}{F(\vect{z})\geq q\\ \vect{z}\geq\vect{0}}
% → problema de optimización: «max» con la variable debajo y la función
% objetivo en la primera línea; debajo, «s.a.» y cada restricción en su línea
% (separadas por \\), alineadas. Va dentro de $$…$$, \[…\], equation o
% \funcionclave. Sin restricciones: {} en el cuarto argumento. Para la web y
% Word, construir-tema.py lo expande a un array antes de pandoc.
\ExplSyntaxOn
\seq_new:N \l__tcee_restr_seq
\NewDocumentCommand{\optim}{mmmm}
  {
    \seq_set_split:Nnn \l__tcee_restr_seq { \\ } {#4}
    \seq_remove_all:Nn \l__tcee_restr_seq { }
    \begin{array}{@{}r@{\quad}l@{}}
      \displaystyle #1 \sb { #2 } & \displaystyle #3
      \seq_if_empty:NF \l__tcee_restr_seq
        { \\ [2pt] \text{s.a.} & \seq_use:Nn \l__tcee_restr_seq { \\ [2pt] & } }
    \end{array}
  }
\ExplSyntaxOff
% \graficonota{nombre} → gráfico pequeño (0,45 del ancho, centrado) dentro de
% una nota al pie: \footnote{Texto de la nota.\graficonota{curva-aprendizaje}}.
% Con otro ancho: \graficonota[0.35]{nombre}.
\newcommand{\graficonota}[2][0.45]{\par\vspace{3pt}{\centering\includegraphics[width=#1\linewidth]{#2}\par}\vspace{1pt}}

% --- Cajas ----------------------------------------------------------------------
% Nota al opositor: consejo útil para el cante (sustituye a la caja amarilla
% con texto rojo de los Word antiguos).
\newtcolorbox{notaopositor}[1][]{enhanced,breakable,
  colback=tceemoradopalido,colframe=tceemorado,boxrule=0pt,leftrule=3pt,arc=1pt,
  fontupper=\small,left=8pt,right=8pt,top=5pt,bottom=5pt,
  title={\textsc{Nota al opositor}},coltitle=tceemorado,fonttitle=\small\bfseries,
  attach title to upper={\ \textbullet\ },#1}
% Anotaciones: lecturas recomendadas, enlaces y material complementario.
\newtcolorbox{anotaciones}[1][]{enhanced,breakable,
  colback=tceegrisclaro!55,colframe=tceegris,boxrule=0.4pt,arc=1pt,
  fontupper=\footnotesize,left=8pt,right=8pt,top=4pt,bottom=4pt,#1}
% Idea clave: frase que conviene decir tal cual en el cante.
\newtcolorbox{ideaclave}[1][]{enhanced,breakable,
  colback=tceesalvia,colframe=tceesalviaoscuro,boxrule=0.6pt,arc=2pt,
  fontupper=\itshape,left=8pt,right=8pt,top=5pt,bottom=5pt,#1}
% Esquema del tema (para la pizarra)
\newtcolorbox{esquema}[1][]{enhanced,breakable,
  colback=tceecrema,colframe=tceemorado,boxrule=0.6pt,arc=2pt,
  title={Esquema del tema},fonttitle=\bfseries,colbacktitle=tceemorado,
  fontupper=\small,#1}

% --- Figuras y tablas ---------------------------------------------------------
% Título encima («Gráfico 1.– …») y fuente obligatoria debajo con \fuente{…}.
\captionsetup{font=small,labelfont={bf,color=tceemorado},labelsep=endash,
  justification=centering,position=top,skip=4pt}
\captionsetup[figure]{name=Gráfico}
\captionsetup[table]{name=Tabla}
\newcommand{\fuente}[1]{\par\vspace{2pt}{\centering\footnotesize\itshape Fuente: #1\par}}
\newcommand{\grafico}[2][0.75\textwidth]{%
  \includegraphics[width=#1]{#2}}
