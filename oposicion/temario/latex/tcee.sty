% --- Numeración de páginas por partes ------------------------------------------
% El tema (de la portada a la conclusión) va en 1…N; tras \appendix, los anexos
% en A-1…; la bibliografía (\bibliografia) en B-1…, haya anexos o no. El pie
% dice «página/páginas de la parte» y la portada, cuántas tiene cada parte
% (con dos pasadas: el número se guarda en el .aux como
% \global\@namedef{tcee@pags@<parte>}{n}; construir-tema.py y verificar-tema.py
% lo leen de ahí).
\newcommand{\tcee@parte}{tema}
\newcommand{\tcee@pags}[1]{\ifcsname tcee@pags@#1\endcsname\csname tcee@pags@#1\endcsname\else ?\fi}
\newcommand{\tcee@totalparte}{\tcee@pags{\tcee@parte}}
\newcommand{\tcee@cierraparte}{\clearpage
  \if@filesw\immediate\write\@auxout{\string\global\string\@namedef{tcee@pags@\tcee@parte}{\the\numexpr\value{page}-1\relax}}\fi}
% \tcee@nuevaparte{nombre}{letra}
\newcommand{\tcee@nuevaparte}[2]{\tcee@cierraparte\gdef\tcee@parte{#1}%
  \setcounter{page}{1}\gdef\thepage{#2-\arabic{page}}}
\preto\appendix{\tcee@nuevaparte{anexos}{A}}
\AtEndDocument{\tcee@cierraparte}
% Línea de la portada: «Tema: 18 págs. · Anexos: 6 · Bibliografía: 2»
% \tceeguia: en la guía del dictamen (1D01) dice «Guía:» en vez de «Tema:»
\newcommand{\tcee@nombrepags}{Tema}
\newcommand{\tceeguia}{\renewcommand{\tcee@nombrepags}{Guía}}
\newcommand{\tcee@lineapaginas}{{\footnotesize\itshape\color{tceegris}%
  \tcee@nombrepags: \tcee@pags{tema}~págs.%
  \ifcsname tcee@pags@anexos\endcsname\ \textperiodcentered\ Anexos: \tcee@pags{anexos}\fi
  \ifcsname tcee@pags@bib\endcsname\ \textperiodcentered\ Bibliografía: \tcee@pags{bib}\fi\par}}

