<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de la pantalla de inicio: cuenta atrás, próximo cante o clase,
     semana del cronograma y test diario. Se redibuja cada 30 min (los días
     y el «hoy»/«mañana» se calculan aquí) y cuando la app guarda datos. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_tcee"
    android:previewLayout="@layout/widget_tcee"
    android:description="@string/widget_descripcion"
    android:widgetCategory="home_screen"/>
