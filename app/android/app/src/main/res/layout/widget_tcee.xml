<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Cuenta atrás al próximo ejercicio -->
    <LinearLayout
        android:id="@+id/widget_cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_dias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="—"
            android:textColor="@color/widget_primario"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dias_texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="Pon la fecha del examen"
            android:textColor="@color/widget_texto_suave"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_siglas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TCEE"
            android:textColor="@color/widget_dorado"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Próximo cante o clase -->
    <TextView
        android:id="@+id/widget_cante"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_fila"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="Sin cantes programados"
        android:textColor="@color/widget_texto"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- Esta semana del cronograma -->
        <TextView
            android:id="@+id/widget_semana"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_fila"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="Sin cronograma"
            android:textColor="@color/widget_texto"
            android:textSize="12sp" />

        <!-- Test diario -->
        <TextView
            android:id="@+id/widget_test"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_fila"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="Test diario"
            android:textColor="@color/widget_texto"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
