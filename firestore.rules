rules_version = '2';
// Reglas de seguridad de Firestore para el proyecto web-vgm.
// Compartidas por la web (auth.js, simulator-history.js) y la app móvil.
// Aplicar desde la consola de Firebase (Firestore Database → Reglas) o con `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function conSesion() {
      return request.auth != null;
    }

    // Administradores: documentos creados a mano en la consola, cuyo ID es el
    // uid o el correo de Google (verificado) del administrador.
    function correo() {
      return request.auth.token.get('email_verified', false) == true ? request.auth.token.get('email', '') : '';
    }
    function esAdmin() {
      return conSesion()
        && (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || (correo() != '' && exists(/databases/$(database)/documents/admins/$(correo()))));
    }

    // Preparador verificado y en activo (lo da de alta el administrador u otro
    // verificado; el administrador puede retirarlo poniendo activo = false).
    function esVerificado() {
      return conSesion()
        && exists(/databases/$(database)/documents/preparadoresVerificados/$(request.auth.uid))
        && get(/databases/$(database)/documents/preparadoresVerificados/$(request.auth.uid)).data.activo == true;
    }

    // Un preparador lo es de un alumno cuando el alumno ha creado, en su propio
    // subárbol, el documento users/{alumno}/preparadores/{preparador}, y sigue
    // verificado: si se le retira la verificación, pierde el acceso.
    function esPreparadorDe(uid) {
      return esVerificado()
        && exists(/databases/$(database)/documents/users/$(uid)/preparadores/$(request.auth.uid));
    }

    // El usuario ha enlazado su app con ese preparador.
    function tengoDePreparador(preparador) {
      return conSesion()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/preparadores/$(preparador));
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Cada usuario solo puede leer y escribir su propio subárbol:
    //   users/{uid}/exam_results/{id}        resultados de test (web y app)
    //   users/{uid}/progress/spaced_repetition   repaso Leitner (app; la web lo adoptará después)
    //   users/{uid}/progress/settings        convocatoria, temas estudiados, racha
    //   users/{uid}/progress/plan            fechas de los ejercicios, hitos y horario
    //   users/{uid}/progress/preparador      perfil de preparador (código para alumnos)
    //   users/{uid}/notes/{codigoTema}       notas propias por tema
    //   users/{uid}/cantes/{id}              cantes programados y diario
    //   users/{uid}/alumnos/{id}             alumnos de un preparador
    //   users/{uid}/sesiones/{id}            sesiones de un preparador con sus alumnos
    //   users/{uid}/preparadores/{prep}      preparadores a los que el usuario da acceso
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // El preparador enlazado ve los temas que marca su alumno y sus cantes.
    // No ve tests (exam_results), notas ni el resto del progreso.
    match /users/{uid}/progress/settings {
      allow get: if esPreparadorDe(uid);
    }
    match /users/{uid}/cantes/{id} {
      allow read: if esPreparadorDe(uid);
      // Solo puede crear y cambiar los cantes que firma con su uid: los que el
      // alumno programa por su cuenta no los puede tocar.
      allow create: if esPreparadorDe(uid) && request.resource.data.preparador == request.auth.uid;
      allow update: if esPreparadorDe(uid)
        && resource.data.preparador == request.auth.uid
        && request.resource.data.preparador == request.auth.uid;
    }
    // El preparador puede leer su propio permiso y renunciar a él.
    match /users/{uid}/preparadores/{preparador} {
      allow get, delete: if request.auth != null && request.auth.uid == preparador;
    }

    // Código que el preparador da a sus alumnos: codigos/{codigo} → { uid, nombre }.
    // Se consulta de uno en uno (no se pueden listar), solo lo reserva un
    // preparador verificado y solo lo cambia su dueño.
    match /codigos/{codigo} {
      allow get: if request.auth != null;
      allow create: if esVerificado() && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Alumnos enlazados con un preparador: los escribe el alumno al enlazar y
    // los lee el preparador para saber quién se ha enlazado. Cualquiera de los
    // dos puede romper el enlace.
    match /preparadores/{preparador}/alumnos/{alumno} {
      allow read: if request.auth != null && (request.auth.uid == preparador || request.auth.uid == alumno);
      allow create, update: if request.auth != null && request.auth.uid == alumno && request.resource.data.uid == alumno;
      allow delete: if request.auth != null && (request.auth.uid == preparador || request.auth.uid == alumno);
    }

    // ---------------------------------------------------- Red de preparadores

    // Lo lee cada uno el suyo (para saber si es administrador).
    match /admins/{id} {
      allow get: if conSesion() && (request.auth.uid == id || (correo() != '' && correo() == id));
    }

    // Lista de preparadores verificados: la ve cualquiera con cuenta (para
    // elegir a quién pedir una sustitución). Da de alta el administrador o un
    // verificado, nunca uno mismo; el interesado solo cambia su nombre y sus
    // ejercicios; retirar (activo = false) o borrar, solo el administrador.
    match /preparadoresVerificados/{uid} {
      allow read: if conSesion();
      allow create: if (esAdmin() || (esVerificado() && uid != request.auth.uid))
        && request.resource.data.uid == uid
        && request.resource.data.avaladoPor == request.auth.uid
        && request.resource.data.activo == true;
      allow update: if esAdmin()
        || (request.auth.uid == uid && resource.data.activo == true && soloCambia(['nombre', 'ejercicios']));
      allow delete: if esAdmin();
    }

    // Peticiones de verificación: las crea el interesado y las leen él, el
    // administrador y los verificados: todos si va abierta (paraTodos) o solo
    // el preparador al que se la pide (destinatario). Se borran al resolverlas.
    function solicitudParaMi() {
      return esVerificado() && (resource.data.paraTodos == true || resource.data.destinatario == request.auth.uid);
    }
    match /solicitudesPreparador/{uid} {
      allow read: if (conSesion() && request.auth.uid == uid) || esAdmin() || solicitudParaMi();
      allow create, update: if conSesion() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow delete: if (conSesion() && request.auth.uid == uid) || esAdmin() || solicitudParaMi();
    }

    // Sustituciones: el alumno publica un cante para que se lo coja otro
    // preparador. La ven el alumno, los verificados a los que va dirigida y
    // quien la coge. Coger = pasar de abierta a cogida firmando con su uid.
    // La hora que elige quien coge el cante cae dentro de la franja del alumno
    // (las fechas son textos ISO del mismo formato, que se comparan bien).
    function horaEnLaFranja() {
      let hora = request.resource.data.get('hora', resource.data.fecha);
      let hasta = resource.data.get('hasta', null);
      return (hasta == null && hora == resource.data.fecha)
        || (hasta != null && hora >= resource.data.fecha && hora <= hasta);
    }
    match /sustituciones/{id} {
      allow read: if (conSesion() && (resource.data.alumno == request.auth.uid || resource.data.cogidaPor == request.auth.uid))
        || (esVerificado() && (resource.data.paraTodos == true || request.auth.uid in resource.data.destinatarios));
      allow create: if conSesion() && request.resource.data.alumno == request.auth.uid && request.resource.data.estado == 'abierta';
      allow update: if (conSesion() && resource.data.alumno == request.auth.uid && request.resource.data.alumno == request.auth.uid)
        || (esVerificado()
          && resource.data.estado == 'abierta'
          && resource.data.alumno != request.auth.uid
          && (resource.data.paraTodos == true || request.auth.uid in resource.data.destinatarios)
          && request.resource.data.estado == 'cogida'
          && request.resource.data.cogidaPor == request.auth.uid
          && soloCambia(['estado', 'cogidaPor', 'cogidaPorNombre', 'hora', 'updatedAt'])
          && horaEnLaFranja());
      allow delete: if conSesion() && resource.data.alumno == request.auth.uid;

      // Contactos: privado/alumno (lo escribe el alumno) y privado/preparador
      // (lo escribe quien la coge). Solo los leen ellos dos.
      match /privado/{quien} {
        function sust() {
          return get(/databases/$(database)/documents/sustituciones/$(id)).data;
        }
        // getAfter: privado/alumno se escribe en el mismo lote que crea la
        // petición, y la regla tiene que verla ya creada.
        function sustDespues() {
          return getAfter(/databases/$(database)/documents/sustituciones/$(id)).data;
        }
        allow read: if conSesion() && (sust().alumno == request.auth.uid || sust().cogidaPor == request.auth.uid);
        allow write: if conSesion()
          && ((quien == 'alumno' && sustDespues().alumno == request.auth.uid)
            || (quien == 'preparador' && sustDespues().cogidaPor == request.auth.uid));
      }
    }

    // Huecos libres de un preparador: los ve él y sus alumnos enlazados.
    match /huecos/{preparador} {
      allow read: if (conSesion() && request.auth.uid == preparador) || tengoDePreparador(preparador);
      allow write: if esVerificado() && request.auth.uid == preparador;
    }

    // Reservas de un alumno en los huecos de su preparador.
    match /reservas/{id} {
      allow read: if conSesion() && (resource.data.alumno == request.auth.uid || resource.data.preparador == request.auth.uid);
      allow create: if conSesion()
        && request.resource.data.alumno == request.auth.uid
        && request.resource.data.estado == 'pedida'
        && tengoDePreparador(request.resource.data.preparador);
      allow update: if conSesion()
        && ((resource.data.preparador == request.auth.uid && request.resource.data.estado in ['aceptada', 'rechazada'] && soloCambia(['estado', 'updatedAt']))
          || (resource.data.alumno == request.auth.uid && request.resource.data.estado == 'cancelada' && soloCambia(['estado', 'updatedAt'])));
      allow delete: if conSesion() && (resource.data.alumno == request.auth.uid || resource.data.preparador == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
